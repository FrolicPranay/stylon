          },
          {
            "value": "0",
            "label": "Horizontal (0°)"
          }
        ],
        "default": "-90"
      },
      {
        "type": "font_picker",
        "id": "sma_vertical_font",
        "label": "Font Family",
        "default": "assistant_n7"
      },
      {
        "type": "range",
        "id": "sma_text_size_desktop",
        "min": 20,
        "max": 120,
        "step": 2,
        "unit": "px",
        "label": "Text Size (Desktop)",
        "default": 76
      },
      {
        "type": "range",
        "id": "sma_text_size_mobile",
        "min": 16,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "Text Size (Mobile)",
        "default": 54
      },
      {
        "type": "select",
        "id": "sma_text_z_index",
        "label": "Text Layer Position",
        "options": [
          {
            "value": "1",
            "label": "Behind Image (Requires Transparent Image)"
          },
          {
            "value": "4",
            "label": "In Front of Image"
          }
        ],
        "default": "1"
      },
      {
        "type": "select",
        "id": "sma_text_blend",
        "label": "Text Blend Mode",
        "options": [
          {
            "value": "normal",
            "label": "Normal"
          },
          {
            "value": "overlay",
            "label": "Overlay"
          },
          {
            "value": "difference",
            "label": "Difference"
          },
          {
            "value": "screen",
            "label": "Screen"
          }
        ],
        "default": "overlay"
      },
      {
        "type": "color",
        "id": "sma_text_color",
        "label": "Text Color",
        "default": "#ffffff"
      },
      {
        "type": "range",
