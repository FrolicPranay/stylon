{% doc %}
  @prompt
    Create a beautiful full-width hero banner section for a luxury Indian ethnic fashion brand (Stylon). The banner should feature: a full-viewport-height background image with a dark overlay for text contrast, a centered editorial layout with a small elegant eyebrow text (e.g. "New Collection"), a large bold headline in a premium serif or display font, a short subheading in a lighter weight, and a minimal CTA button with a thin border style (ghost button). Include smooth fade-in animation on load. The color palette should be dark and moody with gold accent on the CTA button border and hover state. All text and button should be customizable via theme editor settings (heading text, subheading, button label, button link, background image).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    opacity: 0;
  }

  .ai-luxury-hero-{{ ai_gen_id }}.loaded {
    animation: ai-hero-fade-in-{{ ai_gen_id }} 1.2s ease-out forwards;
  }

  @keyframes ai-hero-fade-in-{{ ai_gen_id }} {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  .ai-luxury-hero-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-luxury-hero-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-luxury-hero-background-placeholder-{{ ai_gen_id }} svg {
    width: 200px;
    height: 200px;
    opacity: 0.1;
  }

  .ai-luxury-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
    text-align: center;
    pointer-events: none;
    font-family: var(--font-body-family);
  }

  .ai-luxury-hero-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-luxury-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-luxury-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: {{ block.settings.content_max_width }}px;
    padding: 0 20px;
    color: {{ block.settings.text_color }};
  }

  .ai-luxury-hero-eyebrow-{{ ai_gen_id }} {
    font-family: var(--font-{{ block.settings.eyebrow_font }}-family);
    font-size: {{ block.settings.eyebrow_size }}px;
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ block.settings.eyebrow_spacing }}px;
    opacity: 0;
  }

  .ai-luxury-hero-{{ ai_gen_id }}.loaded .ai-luxury-hero-eyebrow-{{ ai_gen_id }} {
    animation: ai-hero-slide-up-{{ ai_gen_id }} 0.8s ease-out 0.3s forwards;
  }

  .ai-luxury-hero-heading-{{ ai_gen_id }} {
    font-family: var(--font-{{ block.settings.heading_font }}-family);
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: {{ block.settings.heading_line_height }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    opacity: 0;
  }

  .ai-luxury-hero-{{ ai_gen_id }}.loaded .ai-luxury-hero-heading-{{ ai_gen_id }} {
    animation: ai-hero-slide-up-{{ ai_gen_id }} 0.8s ease-out 0.5s forwards;
  }

  .ai-luxury-hero-subheading-{{ ai_gen_id }} {
    font-family: var(--font-{{ block.settings.subheading_font }}-family);
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    line-height: {{ block.settings.subheading_line_height }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    opacity: 0.9;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
  }

  .ai-luxury-hero-{{ ai_gen_id }}.loaded .ai-luxury-hero-subheading-{{ ai_gen_id }} {
    animation: ai-hero-slide-up-{{ ai_gen_id }} 0.8s ease-out 0.7s forwards;
  }

  .ai-luxury-hero-button-wrapper-{{ ai_gen_id }} {
    margin-top: {{ block.settings.button_spacing }}px;
    opacity: 0;
  }

  .ai-luxury-hero-{{ ai_gen_id }}.loaded .ai-luxury-hero-button-wrapper-{{ ai_gen_id }} {
    animation: ai-hero-slide-up-{{ ai_gen_id }} 0.8s ease-out 0.9s forwards;
  }

  .ai-luxury-hero-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: var(--font-{{ block.settings.button_font }}-family);
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-luxury-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_border_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @keyframes ai-hero-slide-up-{{ ai_gen_id }} {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-luxury-hero-{{ ai_gen_id }} {
      min-height: 500px;
    }

    .ai-luxury-hero-eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.8 }}px;
    }

    .ai-luxury-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-luxury-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-luxury-hero-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.85 }}px {{ block.settings.button_padding_horizontal | times: 0.85 }}px;
    }
  }
{% endstyle %}

<luxury-hero-{{ ai_gen_id }}
  class="ai-luxury-hero-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-luxury-hero-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-luxury-hero-background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-luxury-hero-empty-state-{{ ai_gen_id }}">
          Next, add a background image
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-luxury-hero-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-luxury-hero-content-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank %}
      <div class="ai-luxury-hero-eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow_text }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h1 class="ai-luxury-hero-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-luxury-hero-subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    {% if block.settings.button_label != blank %}
      <div class="ai-luxury-hero-button-wrapper-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.button_link }}"
          class="ai-luxury-hero-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</luxury-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        setTimeout(() => {
          this.classList.add('loaded');
        }, 100);
      }
    }

    customElements.define('luxury-hero-{{ ai_gen_id }}', LuxuryHero{{ ai_gen_id }});
  })();
</script>

