{% doc %}
  @prompt
    Create a beautiful, premium "Shop by Collection" section with these exact specs:
    
    LAYOUT & GRID:
    - 4 columns on desktop, 3 columns on tablet (768px–1024px), 2 columns on mobile (below 768px)
    - Customizable left and right padding (padding-inline-start, padding-inline-end), both defaulting to 0px
    - Customizable top and bottom padding
    - Optional section heading, centered or left-aligned
    
    CARDS:
    - Clean card design with subtle rounded corners (border-radius: 8px–12px)
    - Collection image fills the card top portion (object-fit: cover, consistent 4:5 portrait aspect ratio)
    - NO overlay, NO gradient, NO darkening on the image at all — image stays fully bright and clean
    - Collection title displayed BELOW the image, not on top of it
    - Title: elegant, bold, dark text, left-aligned or centered, medium font size
    - Optional short collection description below the title in lighter/smaller text
    - Subtle hover effect: soft box-shadow lift or slight scale on the card
    - Entire card is clickable and links to the collection page
    
    HEADER ROW:
    - Section heading on the left
    - "View All Collections" text link on the right, linking to {{ routes.collections_url }}
    - Header row uses flexbox: justify-content: space-between; align-items: center
    
    SCHEMA SETTINGS:
    - Section heading (text)
    - Number of collections to display
    - Left padding (range 0–100, default 0)
    - Right padding (range 0–100, default 0)
    - Top padding (range 0–80, default 30)
    - Bottom padding (range 0–80, default 30)
    
    Keep code semantic, clean, and production-ready. Luxury fashion brand aesthetic., make thie section look more good and modern. make collection cards look more good and modern
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-collections-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-inline-start: {{ block.settings.padding_left }}px;
    padding-inline-end: {{ block.settings.padding_right }}px;
    background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
  }

  .ai-shop-collections-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-shop-collections-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 48px;
  }

  .ai-shop-collections-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: 40px;
    font-weight: 600;
    color: #000000;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    letter-spacing: -0.02em;
    {% if block.settings.heading_alignment == 'left' %}
      text-align: left;
    {% else %}
      text-align: center;
    {% endif %}
  }

  .ai-shop-collections-view-all-{{ ai_gen_id }} {
    font-size: 14px;
    color: #000000;
    text-decoration: none;
    font-weight: 500;
    padding: 10px 24px;
    border: 1.5px solid #000000;
    border-radius: 50px;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .ai-shop-collections-view-all-{{ ai_gen_id }}:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .ai-shop-collections-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .ai-shop-collection-card-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    position: relative;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-shop-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
  }

  .ai-shop-collection-card-{{ ai_gen_id }}:hover .ai-shop-collection-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-shop-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px;
    background-color: #f8f8f8;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .ai-shop-collection-card-{{ ai_gen_id }}:hover .ai-shop-collection-image-wrapper-{{ ai_gen_id }} {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
  }

  .ai-shop-collection-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-shop-collection-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f5f5 0%, #ebebeb 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-shop-collection-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.2;
  }

  .ai-shop-collection-info-{{ ai_gen_id }} {
    padding: 20px 4px 0;
  }

  .ai-shop-collection-title-{{ ai_gen_id }} {
    margin: 0 0 8px 0;
    font-size: 20px;
    font-weight: 600;
    color: #000000;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    letter-spacing: -0.01em;
    line-height: 1.3;
    {% if block.settings.title_alignment == 'left' %}
      text-align: left;
    {% else %}
      text-align: center;
    {% endif %}
  }

  .ai-shop-collection-description-{{ ai_gen_id }} {
    margin: 0;
    font-size: 14px;
    color: #6b6b6b;
    line-height: 1.6;
    {% if block.settings.title_alignment == 'left' %}
      text-align: left;
    {% else %}
      text-align: center;
    {% endif %}
  }

  .ai-shop-collection-count-{{ ai_gen_id }} {
    display: inline-block;
    margin-top: 8px;
    font-size: 13px;
    color: #999999;
    font-weight: 500;
    {% if block.settings.title_alignment == 'left' %}
      text-align: left;
    {% else %}
      text-align: center;
      width: 100%;
    {% endif %}
  }

  @media screen and (max-width: 1024px) and (min-width: 768px) {
    .ai-shop-collections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    .ai-shop-collections-heading-{{ ai_gen_id }} {
      font-size: 36px;
    }
  }

  @media screen and (max-width: 767px) {
    .ai-shop-collections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ai-shop-collections-header-{{ ai_gen_id }} {
      margin-bottom: 32px;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .ai-shop-collections-heading-{{ ai_gen_id }} {
      font-size: 28px;
    }

    .ai-shop-collection-title-{{ ai_gen_id }} {
      font-size: 17px;
    }

    .ai-shop-collection-description-{{ ai_gen_id }} {
      font-size: 13px;
    }

    .ai-shop-collection-info-{{ ai_gen_id }} {
      padding: 14px 2px 0;
    }

    .ai-shop-collection-image-wrapper-{{ ai_gen_id }} {
      border-radius: 12px;
    }

    .ai-shop-collections-view-all-{{ ai_gen_id }} {
      padding: 8px 20px;
      font-size: 13px;
    }
  }
{% endstyle %}

<shop-by-collections-{{ ai_gen_id }} class="ai-shop-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-collections-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank or block.settings.show_view_all %}
      <div class="ai-shop-collections-header-{{ ai_gen_id }}">
        {% if block.settings.section_heading != blank %}
          <h2 class="ai-shop-collections-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
        {% else %}
          <div></div>
        {% endif %}
        
        {% if block.settings.show_view_all %}
          <a href="{{ routes.collections_url }}" class="ai-shop-collections-view-all-{{ ai_gen_id }}">
            View All Collections
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-shop-collections-grid-{{ ai_gen_id }}">
      {% assign collections_list = block.settings.collections %}
      {% assign display_count = block.settings.number_of_collections %}
      
      {% if collections_list.size > 0 %}
        {% for collection in collections_list limit: display_count %}
          <a href="{{ collection.url }}" class="ai-shop-collection-card-{{ ai_gen_id }}">
            <div class="ai-shop-collection-image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="750"
                  class="ai-shop-collection-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-shop-collection-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-shop-collection-info-{{ ai_gen_id }}">
              <h3 class="ai-shop-collection-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              {% if block.settings.show_description and collection.description != blank %}
                <p class="ai-shop-collection-description-{{ ai_gen_id }}">
                  {{ collection.description | strip_html | truncate: 80 }}
                </p>
              {% endif %}
              {% if block.settings.show_product_count %}
                <span class="ai-shop-collection-count-{{ ai_gen_id }}">
                  {{ collection.products_count }} 
                  {% if collection.products_count == 1 %}
                    product
                  {% else %}
                    products
                  {% endif %}
                </span>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..display_count) %}
          <div class="ai-shop-collection-card-{{ ai_gen_id }}">
            <div class="ai-shop-collection-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-shop-collection-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-shop-collection-info-{{ ai_gen_id }}">
              <h3 class="ai-shop-collection-title-{{ ai_gen_id }}">Collection {{ i }}</h3>
              {% if block.settings.show_description %}
                <p class="ai-shop-collection-description-{{ ai_gen_id }}">
                  Add your collection to showcase your products
                </p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</shop-by-collections-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopByCollections{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('shop-by-collections-{{ ai_gen_id }}', ShopByCollections{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Shop by collection",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "number_of_collections",
      "label": "Number to display",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Shop by collection"
    }
  ]
}
{% endschema %}
