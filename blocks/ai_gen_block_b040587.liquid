{% doc %}
  @prompt
    Create a clean, elegant "Shop by Collection" section. Place the section heading on the top-left and a "View More" button on the top-right. Below, display a neat responsive grid of collection cards featuring only the collection image and collection title. Use a premium, minimal ecommerce style with balanced spacing, subtle hover effects, rounded corners, and a polished layout that works beautifully on both desktop and mobile., give left and right padding option for this block and keep it 0.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-collections-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-shop-collections-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-shop-collections-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
    gap: 16px;
  }

  .ai-shop-collections-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .ai-shop-collections-view-more-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    white-space: nowrap;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-shop-collections-view-more-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-1px);
  }

  .ai-shop-collections-view-more-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-shop-collections-view-more-{{ ai_gen_id }}:hover .ai-shop-collections-view-more-icon-{{ ai_gen_id }} {
    transform: translateX(3px);
  }

  .ai-shop-collections-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-shop-collections-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-color: {{ block.settings.card_background }};
  }

  .ai-shop-collections-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }

  .ai-shop-collections-card-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-shop-collections-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-shop-collections-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-shop-collections-card-{{ ai_gen_id }}:hover .ai-shop-collections-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-shop-collections-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-shop-collections-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-shop-collections-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-shop-collections-card-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    font-weight: 500;
    text-align: {{ block.settings.title_alignment }};
    letter-spacing: -0.01em;
  }

  .ai-shop-collections-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-shop-collections-empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 14px;
  }

  @media screen and (max-width: 989px) {
    .ai-shop-collections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-shop-collections-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-shop-collections-{{ ai_gen_id }} {
      padding-left: {{ block.settings.mobile_padding }}px;
      padding-right: {{ block.settings.mobile_padding }}px;
    }

    .ai-shop-collections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-shop-collections-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-shop-collections-header-{{ ai_gen_id }} {
      {% if block.settings.mobile_header_layout == 'column' %}
        flex-direction: column;
        align-items: flex-start;
      {% else %}
        flex-direction: row;
        align-items: center;
      {% endif %}
    }

    .ai-shop-collections-view-more-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
    }
  }
{% endstyle %}

<shop-by-collections-{{ ai_gen_id }}
  class="ai-shop-collections-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-shop-collections-container-{{ ai_gen_id }}">
    <div class="ai-shop-collections-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-shop-collections-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.view_more_link != blank and block.settings.view_more_text != blank %}
        <a
          href="{{ block.settings.view_more_link }}"
          class="ai-shop-collections-view-more-{{ ai_gen_id }}"
        >
          {{ block.settings.view_more_text }}
          <svg
            class="ai-shop-collections-view-more-icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>

    {% if block.settings.collections != blank %}
      <div class="ai-shop-collections-grid-{{ ai_gen_id }}">
        {% for collection in block.settings.collections limit: block.settings.collections_limit %}
          <div class="ai-shop-collections-card-{{ ai_gen_id }}">
            <a
              href="{{ collection.url }}"
              class="ai-shop-collections-card-link-{{ ai_gen_id }}"
            >
              <div class="ai-shop-collections-image-wrapper-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-shop-collections-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                  >
                {% else %}
                  <div class="ai-shop-collections-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-shop-collections-card-content-{{ ai_gen_id }}">
                <h3 class="ai-shop-collections-card-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-shop-collections-empty-state-{{ ai_gen_id }}">
        <p>Next, select collections to display</p>
      </div>
    {% endif %}
  </div>
</shop-by-collections-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopByCollections{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeAccessibility();
      }

      initializeAccessibility() {
        const cards = this.querySelectorAll('.ai-shop-collections-card-{{ ai_gen_id }}');
        cards.forEach((card) => {
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              const link = card.querySelector('.ai-shop-collections-card-link-{{ ai_gen_id }}');
              if (link) link.click();
            }
          });
        });
      }
    }

    customElements.define('shop-by-collections-{{ ai_gen_id }}', ShopByCollections{{ ai_gen_id }});
  })();
</script>

