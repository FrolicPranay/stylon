{% doc %}
  @prompt
    Create a full-width editorial-style homepage section to showcase a product bundle called "Shop More Save More" from the Fast Bundle app. The section should match Stylon's premium Indian ethnic fashion brand: dark/black background with gold accents (
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bundle-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px clamp(20px, 5vw, 72px);
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    box-sizing: border-box;
  }

  .ai-bundle-editorial-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
  }

  .ai-bundle-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 14px;
    color: {{ block.settings.accent_color }};
    font-family: {{ block.settings.accent_font.family }}, {{ block.settings.accent_font.fallback_families }};
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ai-bundle-editorial-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .ai-bundle-editorial-{{ ai_gen_id }}__description {
    max-width: 620px;
    margin: 18px auto 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.7;
  }

  .ai-bundle-editorial-{{ ai_gen_id }}__rule {
    width: 64px;
    height: 1px;
    margin: 28px auto;
    background: {{ block.settings.accent_color }};
  }

  .ai-bundle-editorial-{{ ai_gen_id }}__app {
    width: 100%;
    margin-top: 34px;
    padding: {{ block.settings.app_padding }}px;
    background: {{ block.settings.app_background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-sizing: border-box;
    text-align: left;
  }

  .ai-bundle-editorial-{{ ai_gen_id }}__empty {
    padding: 28px;
    color: {{ block.settings.muted_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 14px;
    line-height: 1.6;
    text-align: center;
  }

  .ai-bundle-editorial-{{ ai_gen_id }}__empty strong {
    display: block;
    margin-bottom: 6px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-bundle-editorial-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.mobile_padding_vertical }}px 18px;
    }

    .ai-bundle-editorial-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-bundle-editorial-{{ ai_gen_id }}__app {
      margin-top: 26px;
      padding: {{ block.settings.mobile_app_padding }}px;
    }
  }
{% endstyle %}

<div class="ai-bundle-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bundle-editorial-{{ ai_gen_id }}__inner">
    {% if block.settings.eyebrow != blank %}
      <p class="ai-bundle-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h2 class="ai-bundle-editorial-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% if block.settings.description != blank %}
      <div class="ai-bundle-editorial-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>
    {% endif %}
    <div class="ai-bundle-editorial-{{ ai_gen_id }}__rule" aria-hidden="true"></div>
    <div class="ai-bundle-editorial-{{ ai_gen_id }}__app">
      {% if block.settings.fast_bundle_code != blank %}
        {{ block.settings.fast_bundle_code }}
      {% else %}
        <div class="ai-bundle-editorial-{{ ai_gen_id }}__empty">
          <strong>Fast Bundle placement</strong>
          Paste the Fast Bundle app embed code here to display the Shop More Save More bundle.
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop more save more",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop More Save More" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Build your edit with considered pieces and enjoy more value across your wardrobe.</p>" },
    { "type": "liquid", "id": "fast_bundle_code", "label": "Fast Bundle app code" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 600, "max": 1600, "step": 50, "unit": "px", "default": 1200 },
    { "type": "range", "id": "padding_vertical", "label": "Desktop spacing", "min": 24, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "mobile_padding_vertical", "label": "Mobile spacing", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "app_padding", "label": "App spacing", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_app_padding", "label": "Mobile app spacing", "min": 0, "max": 32, "step": 4, "unit": "px", "default": 16 },
    { "type": "select", "id": "text_alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 4, "unit": "px", "default": 8 },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "inter_n7" },
    { "type": "font_picker", "id": "accent_font", "label": "Accent font", "default": "inter_n5" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 88, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 24, "max": 52, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 15 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0D0D0D" },
    { "type": "color", "id": "app_background_color", "label": "App background", "default": "#171513" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFF8E7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#E8E0D0" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C9A227" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#5A491D" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#B8AE9C" }
  ],
  "presets": [{ "name": "Shop more save more" }],
  "tag": null,
  "class": "shop-more-save-more-block"
}
{% endschema %}