{% doc %}
  @prompt
    Create a polished, premium responsive storefront section for STYLON that showcases exactly 5 configurable cards. Each card must have a card type text field, an image picker, a title, and a collection picker so the card can link to a selected collection. On desktop, display all 5 cards in one row. On mobile, display a carousel with one card centered, with the neighboring cards partially visible as left and right peeks while the other cards remain out of view. Include exactly 5 pagination dots at the bottom on mobile, with the active dot updating as the customer swipes or navigates. Keep the design minimal, elegant, and consistent with a women's Indian ethnic fashion storefront, with accessible controls and smooth responsive behavior., name it section new arrivals. its product. so add title and pricing 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-stylon-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;color:#171717}.ai-stylon-{{ ai_gen_id }} [data-track]{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}.ai-stylon-{{ ai_gen_id }} [data-card]{min-width:0}.ai-stylon-{{ ai_gen_id }} a{display:block;color:inherit;text-decoration:none}.ai-stylon-{{ ai_gen_id }} .media{aspect-ratio:.78;overflow:hidden;background:#f3f1ed}.ai-stylon-{{ ai_gen_id }} .media img,.ai-stylon-{{ ai_gen_id }} .media svg{display:block;width:100%;height:100%;object-fit:cover}.ai-stylon-{{ ai_gen_id }} .details{text-align:center;padding:14px 2px 0}.ai-stylon-{{ ai_gen_id }} .type{margin:0 0 6px;color:#756f67;font-size:10px;letter-spacing:.16em;text-transform:uppercase}.ai-stylon-{{ ai_gen_id }} h3{margin:0;font-size:16px;line-height:1.35;font-weight:600}.ai-stylon-{{ ai_gen_id }} .price{margin:6px 0 0;font-size:13px;color:#756f67}.ai-stylon-{{ ai_gen_id }} .dots{display:none}@media(max-width:749px){.ai-stylon-{{ ai_gen_id }} [data-track]{display:flex;gap:12px;overflow-x:auto;padding:0 14vw 4px;scroll-snap-type:x mandatory;scrollbar-width:none}.ai-stylon-{{ ai_gen_id }} [data-track]::-webkit-scrollbar{display:none}.ai-stylon-{{ ai_gen_id }} [data-card]{flex:0 0 72vw;scroll-snap-align:center}.ai-stylon-{{ ai_gen_id }} .dots{display:flex;justify-content:center;gap:8px;margin-top:20px}.ai-stylon-{{ ai_gen_id }} .dots button{width:7px;height:7px;padding:0;border:1px solid #171717;border-radius:50%;background:transparent}.ai-stylon-{{ ai_gen_id }} .dots button[aria-current=true]{background:#171717}}{% endstyle %}
<stylon-new-arrivals-{{ ai_gen_id }} class="ai-stylon-{{ ai_gen_id }}" {{ block.shopify_attributes }}><h2 class="section-title">{{ block.settings.section_title }}</h2><div data-track>{% for i in (1..5) %}{% assign ik='card_' | append:i | append:'_image' %}{% assign tk='card_' | append:i | append:'_type' %}{% assign nk='card_' | append:i | append:'_title' %}{% assign pk='card_' | append:i | append:'_product' %}{% assign ck='card_' | append:i | append:'_collection' %}{% assign im=block.settings[ik] %}{% assign ct=block.settings[tk] %}{% assign ti=block.settings[nk] %}{% assign pr=block.settings[pk] %}{% assign co=block.settings[ck] %}<article data-card>{% if co != blank %}<a href="{{ co.url }}">{% else %}<div>{% endif %}<div class="media">{% if im != blank %}<img src="{{ im | image_url: width:900 }}" alt="{{ im.alt | default:ti | escape }}" loading="lazy">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><div class="details">{% if ct != blank %}<p class="type">{{ ct }}</p>{% endif %}<h3>{% if ti != blank %}{{ ti }}{% elsif pr != blank %}{{ pr.title }}{% else %}{{ co.title }}{% endif %}</h3>{% if pr != blank %}<p class="price">{{ pr.price | money }}</p>{% endif %}</div>{% if co != blank %}</a>{% else %}</div>{% endif %}</article>{% endfor %}</div><div class="dots" role="tablist" aria-label="New arrivals slides">{% for i in (1..5) %}<button type="button" data-dot="{{ forloop.index0 }}" role="tab" aria-label="Show item {{ i }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div></stylon-new-arrivals-{{ ai_gen_id }}><script>(function(){class N{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.t=this.querySelector('[data-track]');this.c=[...this.querySelectorAll('[data-card]')];this.d=[...this.querySelectorAll('[data-dot]')];this.t.addEventListener('scroll',()=>this.u());this.d.forEach(x=>x.onclick=()=>this.c[+x.dataset.dot].scrollIntoView({behavior:'smooth',inline:'center'}));this.u()}u(){if(innerWidth>749)return;let m=this.t.scrollLeft+this.t.clientWidth/2,a=0;this.c.forEach((x,i)=>{if(Math.abs(x.offsetLeft+x.offsetWidth/2-m)<Math.abs(this.c[a].offsetLeft+this.c[a].offsetWidth/2-m))a=i});this.d.forEach((x,i)=>x.setAttribute('aria-current',i==a?'true':'false'))}}customElements.define('stylon-new-arrivals-{{ ai_gen_id }}',N{{ ai_gen_id }})})();</script>
{% schema %}{"name":"New arrivals","settings":[{"type":"text","id":"section_title","label":"Section title","default":"New arrivals"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Card 1"},{"type":"text","id":"card_1_type","label":"Card type","default":"The edit"},{"type":"image_picker","id":"card_1_image","label":"Image"},{"type":"text","id":"card_1_title","label":"Title","default":"New arrival one"},{"type":"product","id":"card_1_product","label":"Product"},{"type":"collection","id":"card_1_collection","label":"Collection"},{"type":"header","content":"Card 2"},{"type":"text","id":"card_2_type","label":"Card type","default":"Handcrafted"},{"type":"image_picker","id":"card_2_image","label":"Image"},{"type":"text","id":"card_2_title","label":"Title","default":"New arrival two"},{"type":"product","id":"card_2_product","label":"Product"},{"type":"collection","id":"card_2_collection","label":"Collection"},{"type":"header","content":"Card 3"},{"type":"text","id":"card_3_type","label":"Card type","default":"Occasion dressing"},{"type":"image_picker","id":"card_3_image","label":"Image"},{"type":"text","id":"card_3_title","label":"Title","default":"New arrival three"},{"type":"product","id":"card_3_product","label":"Product"},{"type":"collection","id":"card_3_collection","label":"Collection"},{"type":"header","content":"Card 4"},{"type":"text","id":"card_4_type","label":"Card type","default":"Signature"},{"type":"image_picker","id":"card_4_image","label":"Image"},{"type":"text","id":"card_4_title","label":"Title","default":"New arrival four"},{"type":"product","id":"card_4_product","label":"Product"},{"type":"collection","id":"card_4_collection","label":"Collection"},{"type":"header","content":"Card 5"},{"type":"text","id":"card_5_type","label":"Card type","default":"The finishing touch"},{"type":"image_picker","id":"card_5_image","label":"Image"},{"type":"text","id":"card_5_title","label":"Title","default":"New arrival five"},{"type":"product","id":"card_5_product","label":"Product"},{"type":"collection","id":"card_5_collection","label":"Collection"}],"presets":[{"name":"New arrivals"}],"tag":null,"class":"stylon-new-arrivals-block"}{% endschema %}