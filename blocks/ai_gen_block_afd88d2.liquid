{% doc %}
  @prompt
    Create a premium, modern, responsive Shopify theme section for the STYLON store called “New Arrivals”. The section must automatically display only the 10 latest products, sorted by newest product creation date, with no manual product selection, so it updates as new products are added. Display the products in a smooth horizontal carousel/slider. Each clickable product card must link to the product page and show only the product image, product title, and product price. Do not show descriptions, vendor, reviews, wishlist, quantity, buttons, or any other extra information. If a product is on sale, show a clean compact “X% OFF” badge at the top-right of the product image, dynamically calculated from compare-at price and current selling price, and hide it when there is no valid sale. On desktop, show 5 fully visible cards with consistent widths, equal spacing, aligned image aspect ratios, and intuitive navigation controls. On mobile, show 2 fully visible cards plus approximately one partially visible third card on the right to indicate horizontal swipeability, without page-level horizontal overflow. Make the carousel touch-friendly and smooth. Use a minimal, elegant, fashion-focused premium design matching STYLON: white product titles and a contrasting premium price color that works with the brand accent #FF5A1F. Keep titles and prices consistently aligned, with a controlled title height or line clamp for long names. Ensure the section is responsive across screen sizes and browser zoom levels, resizes smoothly, preserves layout integrity, and is fully compatible with the Shopify theme editor with sensible customizable settings such as heading text, colors, spacing, image aspect ratio, and navigation visibility. Use Shopify Liquid, HTML, CSS, and JavaScript as appropriate, and keep all product data, images, prices, links, and discount percentages dynamic rather than hard-coded., show 1 line titles only
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign latest_products = collections.all.products | sort: 'created_at' | reverse | slice: 0, 10 %}
{% style %}
.ai-new-arrivals-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.section_spacing }}px 0;overflow:hidden;color:{{ block.settings.title_color }}}
.ai-new-arrivals-{{ ai_gen_id }}__header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.ai-new-arrivals-{{ ai_gen_id }}__heading{margin:0;color:{{ block.settings.title_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.1;letter-spacing:-.02em}.ai-new-arrivals-{{ ai_gen_id }}__controls{display:flex;gap:8px}.ai-new-arrivals-{{ ai_gen_id }}__control{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid {{ block.settings.control_border_color }};border-radius:50%;background:{{ block.settings.control_background }};color:{{ block.settings.control_color }};cursor:pointer}.ai-new-arrivals-{{ ai_gen_id }}__control:disabled{opacity:.35;cursor:not-allowed}.ai-new-arrivals-{{ ai_gen_id }}__control:focus-visible{outline:2px solid {{ block.settings.accent_color }};outline-offset:3px}.ai-new-arrivals-{{ ai_gen_id }}__track{display:flex;gap:{{ block.settings.card_gap }}px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain;padding-bottom:4px}.ai-new-arrivals-{{ ai_gen_id }}__track::-webkit-scrollbar{display:none}.ai-new-arrivals-{{ ai_gen_id }}__card{flex:0 0 calc((100% - ({{ block.settings.card_gap }}px * 4))/5);min-width:0;scroll-snap-align:start;text-decoration:none;color:inherit}.ai-new-arrivals-{{ ai_gen_id }}__media{position:relative;overflow:hidden;aspect-ratio:{{ block.settings.image_ratio }};background:{{ block.settings.image_background }};border-radius:{{ block.settings.media_radius }}px}.ai-new-arrivals-{{ ai_gen_id }}__media img,.ai-new-arrivals-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:100%;object-fit:cover}.ai-new-arrivals-{{ ai_gen_id }}__placeholder{width:100%;height:100%}.ai-new-arrivals-{{ ai_gen_id }}__badge{position:absolute;top:12px;right:12px;z-index:1;padding:6px 9px;border-radius:{{ block.settings.badge_radius }}px;background:{{ block.settings.accent_color }};color:#fff;font-size:11px;font-weight:700;letter-spacing:.04em;line-height:1}.ai-new-arrivals-{{ ai_gen_id }}__name{display:-webkit-box;overflow:hidden;height:1.4em;min-height:1.4em;margin:12px 0 5px;color:{{ block.settings.title_color }};font-size:{{ block.settings.card_title_size }}px;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:1}.ai-new-arrivals-{{ ai_gen_id }}__price{margin:0;color:{{ block.settings.price_color }};font-size:{{ block.settings.price_size }}px;font-weight:700;line-height:1.25}@media screen and (max-width:749px){.ai-new-arrivals-{{ ai_gen_id }}{padding:{{ block.settings.mobile_spacing }}px 0}.ai-new-arrivals-{{ ai_gen_id }}__header{margin-bottom:18px}.ai-new-arrivals-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}.ai-new-arrivals-{{ ai_gen_id }}__controls{display:none}.ai-new-arrivals-{{ ai_gen_id }}__card{flex-basis:calc((100% - {{ block.settings.mobile_gap }}px)/2.35)}.ai-new-arrivals-{{ ai_gen_id }}__track{gap:{{ block.settings.mobile_gap }}px}}
{% endstyle %}
<new-arrivals-{{ ai_gen_id }} class="ai-new-arrivals-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-new-arrivals-{{ ai_gen_id }}__header"><h2 class="ai-new-arrivals-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% if block.settings.show_navigation %}<div class="ai-new-arrivals-{{ ai_gen_id }}__controls"><button class="ai-new-arrivals-{{ ai_gen_id }}__control" type="button" data-direction="previous" aria-label="Previous products">&#8592;</button><button class="ai-new-arrivals-{{ ai_gen_id }}__control" type="button" data-direction="next" aria-label="Next products">&#8594;</button></div>{% endif %}</div><div class="ai-new-arrivals-{{ ai_gen_id }}__track" data-track tabindex="0">{% for product in latest_products %}<a class="ai-new-arrivals-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}"><div class="ai-new-arrivals-{{ ai_gen_id }}__media">{% if product.compare_at_price > product.price and product.compare_at_price > 0 %}{% assign discount_amount = product.compare_at_price | minus: product.price %}{% assign discount_percent = discount_amount | times: 100 | divided_by: product.compare_at_price | round %}{% if discount_percent > 0 %}<span class="ai-new-arrivals-{{ ai_gen_id }}__badge">{{ discount_percent }}% OFF</span>{% endif %}{% endif %}{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div class="ai-new-arrivals-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div><span class="ai-new-arrivals-{{ ai_gen_id }}__name">{{ product.title | escape }}</span><span class="ai-new-arrivals-{{ ai_gen_id }}__price">{{ product.price | money }}</span></a>{% endfor %}</div></new-arrivals-{{ ai_gen_id }}>
<script>(()=>{class NewArrivals{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('[data-track]');this.buttons=this.querySelectorAll('[data-direction]');this.buttons.forEach(b=>b.addEventListener('click',()=>this.move(b.dataset.direction)));this.track.addEventListener('scroll',()=>this.updateButtons(),{passive:true});this.updateButtons()}move(d){const c=this.track.querySelector('a');if(!c)return;const x=c.getBoundingClientRect().width+parseFloat(getComputedStyle(this.track).gap);this.track.scrollBy({left:d==='next'?x:-x,behavior:'smooth'})}updateButtons(){const m=this.track.scrollWidth-this.track.clientWidth-2;this.buttons.forEach(b=>{b.disabled=b.dataset.direction==='previous'?this.track.scrollLeft<=2:this.track.scrollLeft>=m})}}customElements.define('new-arrivals-{{ ai_gen_id }}',NewArrivals{{ ai_gen_id }})})();</script>
{% schema %}{"name":"New arrivals","settings":[{"type":"text","id":"heading","label":"Heading","default":"New Arrivals"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"checkbox","id":"show_navigation","label":"Show navigation","default":true},{"type":"header","content":"Layout"},{"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"},{"value":"3 / 4","label":"Tall portrait"}],"default":"4 / 5"},{"type":"range","id":"card_gap","label":"Card spacing","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"mobile_gap","label":"Mobile spacing","min":8,"max":28,"step":4,"unit":"px","default":12},{"type":"range","id":"section_spacing","label":"Desktop spacing","min":0,"max":100,"step":5,"unit":"px","default":50},{"type":"range","id":"mobile_spacing","label":"Mobile spacing","min":0,"max":80,"step":5,"unit":"px","default":30},{"type":"range","id":"media_radius","label":"Image corner radius","min":0,"max":24,"step":2,"unit":"px","default":0},{"type":"header","content":"Colors"},{"type":"color","id":"title_color","label":"Title","default":"#FFFFFF"},{"type":"color","id":"price_color","label":"Price","default":"#FF5A1F"},{"type":"color","id":"accent_color","label":"Accent","default":"#FF5A1F"},{"type":"color","id":"image_background","label":"Image background","default":"#F4F4F4"},{"type":"color","id":"control_background","label":"Control background","default":"#FFFFFF"},{"type":"color","id":"control_color","label":"Control icon","default":"#000000"},{"type":"color","id":"control_border_color","label":"Control border","default":"#DFDFDF"},{"type":"header","content":"Type"},{"type":"range","id":"heading_size","label":"Heading size","min":18,"max":56,"step":2,"unit":"px","default":32},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":16,"max":36,"step":2,"unit":"px","default":24},{"type":"range","id":"card_title_size","label":"Product title size","min":11,"max":20,"step":1,"unit":"px","default":14},{"type":"range","id":"price_size","label":"Price size","min":11,"max":20,"step":1,"unit":"px","default":15},{"type":"range","id":"badge_radius","label":"Badge radius","min":0,"max":20,"step":1,"unit":"px","default":4}],"presets":[{"name":"New arrivals"}],"tag":null,"class":"new-arrivals-block"}{% endschema %}