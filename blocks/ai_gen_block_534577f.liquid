{% doc %}
  @prompt
    Create a luxury marquee block that infinitely scrolls seamlessly on both desktop and mobile without any glitches or jumps. Requirements: 10 customizable text fields in theme settings (text_1 through text_10). The marquee works by duplicating the content strip in HTML so the CSS animation loops from 0 to -50% translateX creating a perfectly seamless loop. Use CSS keyframe animation only (no JavaScript scroll). Add a separator icon (like a diamond or dot) between each text item. Style it to match a dark luxury fashion theme with gold accent color (#C9A96E or similar), elegant serif or spaced sans-serif font, uppercase letters, generous letter spacing (0.15em+). The marquee should pause on hover on desktop. Make the background dark (near black) with the gold text. Smooth animation speed around 30-40 seconds for a premium feel.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-marquee-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; overflow: hidden; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; border-top: 1px solid {{ block.settings.border_color }}; border-bottom: 1px solid {{ block.settings.border_color }}; }
  .ai-luxury-marquee__viewport-{{ ai_gen_id }} { width: 100%; overflow: hidden; padding: {{ block.settings.vertical_padding }}px 0; }
  .ai-luxury-marquee__track-{{ ai_gen_id }} { display: flex; width: max-content; min-width: 200%; animation: ai-luxury-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_duration }}s linear infinite; will-change: transform; }
  .ai-luxury-marquee__group-{{ ai_gen_id }} { display: flex; flex: 0 0 50%; align-items: center; justify-content: space-around; min-width: max-content; }
  .ai-luxury-marquee__item-{{ ai_gen_id }} { display: inline-flex; align-items: center; gap: {{ block.settings.item_gap }}px; flex: 0 0 auto; padding: 0 {{ block.settings.item_gap }}px; font-family: {{ settings.type_accent_font.family }}, serif; font-size: {{ block.settings.text_size }}px; font-weight: 500; letter-spacing: {{ block.settings.letter_spacing }}em; line-height: 1.3; text-transform: uppercase; white-space: nowrap; }
  .ai-luxury-marquee__separator-{{ ai_gen_id }} { display: inline-block; width: {{ block.settings.separator_size }}px; height: {{ block.settings.separator_size }}px; flex: 0 0 auto; background: {{ block.settings.separator_color }}; transform: rotate(45deg); }
  @keyframes ai-luxury-marquee-scroll-{{ ai_gen_id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (hover: hover) and (pointer: fine) { .ai-luxury-marquee:hover .ai-luxury-marquee__track-{{ ai_gen_id }} { animation-play-state: paused; } }
  @media screen and (max-width: 749px) { .ai-luxury-marquee__viewport-{{ ai_gen_id }} { padding: {{ block.settings.mobile_vertical_padding }}px 0; } .ai-luxury-marquee__item-{{ ai_gen_id }} { font-size: {{ block.settings.mobile_text_size }}px; padding-left: {{ block.settings.mobile_item_gap }}px; padding-right: {{ block.settings.mobile_item_gap }}px; } }
  @media (prefers-reduced-motion: reduce) { .ai-luxury-marquee__track-{{ ai_gen_id }} { animation-play-state: paused; } }
{% endstyle %}

<div class="ai-luxury-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-marquee__viewport-{{ ai_gen_id }}" aria-label="{{ block.settings.accessibility_label | escape }}">
    <div class="ai-luxury-marquee__track-{{ ai_gen_id }}">
      {% for group in (1..2) %}
        <div class="ai-luxury-marquee__group-{{ ai_gen_id }}" aria-hidden="{% if group == 1 %}false{% else %}true{% endif %}">
          {% for i in (1..10) %}
            {% assign text_key = 'text_' | append: i %}
            {% assign marquee_text = block.settings[text_key] %}
            {% if marquee_text != blank %}
              <span class="ai-luxury-marquee__item-{{ ai_gen_id }}"><span>{{ marquee_text | escape }}</span><span class="ai-luxury-marquee__separator-{{ ai_gen_id }}" aria-hidden="true"></span></span>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury marquee",
  "tag": null,
  "class": "luxury-marquee-block",
  "settings": [
    { "type": "header", "content": "Marquee content" },
    { "type": "text", "id": "text_1", "label": "Text 1", "default": "The art of occasion" },
    { "type": "text", "id": "text_2", "label": "Text 2", "default": "Crafted for every celebration" },
    { "type": "text", "id": "text_3", "label": "Text 3", "default": "Timeless Indian elegance" },
    { "type": "text", "id": "text_4", "label": "Text 4", "default": "Designed to be remembered" },
    { "type": "text", "id": "text_5", "label": "Text 5", "default": "Modern heirlooms" },
    { "type": "text", "id": "text_6", "label": "Text 6", "default": "Made with intention" },
    { "type": "text", "id": "text_7", "label": "Text 7", "default": "Luxury in every detail" },
    { "type": "text", "id": "text_8", "label": "Text 8", "default": "From our atelier to you" },
    { "type": "text", "id": "text_9", "label": "Text 9", "default": "Celebrate your signature style" },
    { "type": "text", "id": "text_10", "label": "Text 10", "default": "Stylon occasion wear" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "animation_duration", "label": "Scroll duration", "min": 30, "max": 40, "step": 1, "unit": "s", "default": 35 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "mobile_text_size", "label": "Mobile text size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": 0.1, "max": 0.5, "step": 0.1, "unit": "em", "default": 0.2 },
    { "type": "range", "id": "item_gap", "label": "Item spacing", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_item_gap", "label": "Mobile item spacing", "min": 8, "max": 50, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_vertical_padding", "label": "Mobile padding", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "separator_size", "label": "Separator size", "min": 4, "max": 12, "step": 2, "unit": "px", "default": 6 },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Featured brand messages" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#11100F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#C9A96E" },
    { "type": "color", "id": "separator_color", "label": "Separator", "default": "#C9A96E" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#3B3022" }
  ],
  "presets": [{ "name": "Luxury marquee" }]
}
{% endschema %}