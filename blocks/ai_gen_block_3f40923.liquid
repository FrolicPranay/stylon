{% doc %}
  @prompt
    Modify the Premium collection grid block to support 5 columns on desktop. Add a setting option for columns per row on desktop that allows up to 5 columns, and update the CSS grid layout to render 5 columns when selected., nice but instead of selecting collections 1 by 1 . it should fetch all collections present in the system and if i want i can deselect if i want.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-premium-collection-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-premium-collection-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-premium-collection-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin-top: 12px;
  }

  .ai-premium-collection-grid__grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.grid_gap }}px;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
  }

  .ai-premium-collection-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-premium-collection-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-premium-collection-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-premium-collection-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-premium-collection-grid__item-{{ ai_gen_id }}:hover .ai-premium-collection-grid__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-premium-collection-grid__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-premium-collection-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-premium-collection-grid__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.overlay_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-premium-collection-grid__collection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_title_size }}px;
    font-weight: 600;
    margin: 0 0 4px 0;
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-premium-collection-grid__collection-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_count_size }}px;
    opacity: 0.9;
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-premium-collection-grid__link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    text-decoration: none;
    z-index: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-premium-collection-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-premium-collection-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-premium-collection-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-premium-collection-grid__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<premium-collection-grid-{{ ai_gen_id }}
  class="ai-premium-collection-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-premium-collection-grid__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-premium-collection-grid__title-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-premium-collection-grid__description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-premium-collection-grid__grid-{{ ai_gen_id }}">
    {% liquid
      assign excluded_collections = block.settings.excluded_collections | split: ','
      assign collection_limit = block.settings.collection_limit
      assign collections_shown = 0
    %}

    {% for collection in collections %}
      {% liquid
        assign is_excluded = false
        for excluded in excluded_collections
          assign excluded_handle = excluded | strip
          if collection.handle == excluded_handle
            assign is_excluded = true
            break
          endif
        endfor
      %}

      {% if is_excluded == false and collections_shown < collection_limit %}
        {% assign collections_shown = collections_shown | plus: 1 %}
        <div class="ai-premium-collection-grid__item-{{ ai_gen_id }}">
          <a
            href="{{ collection.url }}"
            class="ai-premium-collection-grid__link-{{ ai_gen_id }}"
            aria-label="{{ collection.title }}"
          ></a>

          <div class="ai-premium-collection-grid__image-wrapper-{{ ai_gen_id }}">
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                loading="lazy"
                width="800"
                height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                class="ai-premium-collection-grid__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-premium-collection-grid__image-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.show_overlay %}
              <div class="ai-premium-collection-grid__overlay-{{ ai_gen_id }}">
                <h3 class="ai-premium-collection-grid__collection-title-{{ ai_gen_id }}">
                  {{ collection.title }}
                </h3>
                {% if block.settings.show_product_count %}
                  <div class="ai-premium-collection-grid__collection-count-{{ ai_gen_id }}">
                    {{ collection.products_count }}
                    {% if collection.products_count == 1 %}
                      {{ block.settings.product_label }}
                    {% else %}
                      {{ block.settings.products_label }}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</premium-collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumCollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeGrid();
      }

      initializeGrid() {
        const items = this.querySelectorAll('.ai-premium-collection-grid__item-{{ ai_gen_id }}');
        items.forEach((item, index) => {
          item.style.animationDelay = `${index * 0.05}s`;
        });
      }
    }

    customElements.define('premium-collection-grid-{{ ai_gen_id }}', PremiumCollectionGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
