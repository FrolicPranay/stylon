{% doc %}
  @prompt
    Create a new, production-ready Shopify Liquid section called "New Arrivals" for the STYLON women's fashion store, compatible with the Horizon theme. It should show products from a merchant-selected collection: an editable "NEW ARRIVALS" heading (text, size, weight, color, alignment, and desktop/mobile top and bottom padding all editable), and product cards with the product image filling the card, a subtle dark overlay near the bottom, and the product title in white displayed inside the image near its bottom, with the whole card clickable to the product page. On desktop show up to 5 cards in a responsive grid (no horizontal scrollbar), with a setting to limit the number of products (max 5). On mobile, instead of a stacked grid, use a smooth horizontal scrolling carousel showing about 3 cards at a time using CSS scroll-snap, with the scrollbar hidden and 5 small, elegant pagination dots centered below the carousel that highlight the active position and update as the user swipes (JavaScript only to detect scroll position and update the dots). Cards should have subtle rounded corners, consistent image proportions with object-fit cover, and a slight image zoom on hover on desktop only. Include theme editor settings for collection picker, heading text, product count, card border radius, image aspect ratio, gap between cards, title position/size/weight/color, and overlay opacity. Scope all CSS and JavaScript to the section using section.id, use Shopify's native collection and product objects with responsive, lazy-loaded images, make it accessible with meaningful alt text and keyboard-accessible links, do not rely only on color for the active dot, use no external libraries, and produce one complete section file with Liquid, HTML, CSS, JavaScript, and a valid {% schema %}. The overall look should be clean, minimal, and premium, with STYLON's accent color #FF5A1F.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-new-arrivals-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; padding:{{ block.settings.mobile_padding_top }}px 0 {{ block.settings.mobile_padding_bottom }}px; }
  .ai-new-arrivals__heading-{{ ai_gen_id }} { margin:0 0 24px; color:{{ block.settings.heading_color }}; font-size:{{ block.settings.heading_size }}px; font-weight:{{ block.settings.heading_weight }}; text-align:{{ block.settings.heading_alignment }}; line-height:1.1; }
  .ai-new-arrivals__track-{{ ai_gen_id }} { display:grid; grid-template-columns:repeat({{ block.settings.product_count }}, minmax(0, 1fr)); gap:{{ block.settings.card_gap }}px; }
  .ai-new-arrivals__card-{{ ai_gen_id }} { position:relative; display:block; overflow:hidden; aspect-ratio:{{ block.settings.image_ratio }}; border-radius:{{ block.settings.card_radius }}px; background:#eee; color:#fff; text-decoration:none; }
  .ai-new-arrivals__image-{{ ai_gen_id }}, .ai-new-arrivals__placeholder-{{ ai_gen_id }} { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .ai-new-arrivals__placeholder-{{ ai_gen_id }} { display:flex; align-items:center; justify-content:center; background:#f1f1f1; }
  .ai-new-arrivals__placeholder-{{ ai_gen_id }} svg { width:100%; height:100%; }
  .ai-new-arrivals__overlay-{{ ai_gen_id }} { position:absolute; inset:auto 0 0; height:48%; background:linear-gradient(transparent, rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }})); pointer-events:none; }
  .ai-new-arrivals__title-{{ ai_gen_id }} { position:absolute; left:18px; right:18px; bottom:{{ block.settings.title_position }}px; margin:0; color:{{ block.settings.title_color }}; font-size:{{ block.settings.title_size }}px; font-weight:{{ block.settings.title_weight }}; line-height:1.2; }
  .ai-new-arrivals__dots-{{ ai_gen_id }} { display:none; justify-content:center; gap:8px; margin-top:18px; }
  .ai-new-arrivals__dot-{{ ai_gen_id }} { width:7px; height:7px; padding:0; border:1px solid {{ block.settings.dot_color }}; border-radius:50%; background:transparent; cursor:pointer; }
  .ai-new-arrivals__dot-{{ ai_gen_id }}[aria-current="true"] { background:{{ block.settings.dot_color }}; box-shadow:0 0 0 2px #fff, 0 0 0 3px {{ block.settings.dot_color }}; }
  .ai-new-arrivals__dot-{{ ai_gen_id }}:focus-visible, .ai-new-arrivals__card-{{ ai_gen_id }}:focus-visible { outline:2px solid #FF5A1F; outline-offset:3px; }
  @media screen and (min-width:750px) { .ai-new-arrivals-{{ ai_gen_id }} { padding-top:{{ block.settings.desktop_padding_top }}px; padding-bottom:{{ block.settings.desktop_padding_bottom }}px; } .ai-new-arrivals__card-{{ ai_gen_id }} .ai-new-arrivals__image-{{ ai_gen_id }} { transition:transform .35s ease; } .ai-new-arrivals__card-{{ ai_gen_id }}:hover .ai-new-arrivals__image-{{ ai_gen_id }} { transform:scale(1.04); } }
  @media screen and (max-width:749px) { .ai-new-arrivals__track-{{ ai_gen_id }} { display:flex; gap:{{ block.settings.card_gap }}px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; padding:0 1px 4px; } .ai-new-arrivals__track-{{ ai_gen_id }}::-webkit-scrollbar { display:none; } .ai-new-arrivals__card-{{ ai_gen_id }} { flex:0 0 calc((100% - 2 * {{ block.settings.card_gap }}px) / 3); scroll-snap-align:start; } .ai-new-arrivals__dots-{{ ai_gen_id }} { display:flex; } }
{% endstyle %}

<new-arrivals-{{ ai_gen_id }} class="ai-new-arrivals-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-new-arrivals__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
  {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
    <div class="ai-new-arrivals__track-{{ ai_gen_id }}" data-track>
      {% for product in block.settings.collection.products limit: block.settings.product_count %}
        <a class="ai-new-arrivals__card-{{ ai_gen_id }}" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 1000 | image_tag: class: 'ai-new-arrivals__image-' | append: ai_gen_id, loading: 'lazy', alt: product.featured_image.alt | default: product.title | escape }}
          {% else %}
            <div class="ai-new-arrivals__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>
          {% endif %}
          <span class="ai-new-arrivals__overlay-{{ ai_gen_id }}"></span>
          <h3 class="ai-new-arrivals__title-{{ ai_gen_id }}">{{ product.title | escape }}</h3>
        </a>
      {% endfor %}
    </div>
    <div class="ai-new-arrivals__dots-{{ ai_gen_id }}" role="tablist" aria-label="New arrivals slides">
      {% for i in (1..5) %}<button class="ai-new-arrivals__dot-{{ ai_gen_id }}" type="button" role="tab" aria-label="Go to slide {{ i }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-dot="{{ forloop.index0 }}"></button>{% endfor %}
    </div>
  {% else %}
    <p>Select a collection to display new arrivals.</p>
  {% endif %}
</new-arrivals-{{ ai_gen_id }}>

<script>
(function(){
  const root=document.querySelector('new-arrivals-{{ ai_gen_id }}');
  if(!root)return;
  const track=root.querySelector('[data-track]'), dots=[...root.querySelectorAll('[data-dot]')];
  if(!track||!dots.length)return;
  const update=()=>{const max=track.scrollWidth-track.clientWidth; const index=max>0?Math.min(4,Math.round(track.scrollLeft/max*4)):0; dots.forEach((dot,i)=>dot.setAttribute('aria-current',i===index?'true':'false'));};
  track.addEventListener('scroll',update,{passive:true});
  dots.forEach(dot=>dot.addEventListener('click',()=>{const max=track.scrollWidth-track.clientWidth; track.scrollTo({left:max*(Number(dot.dataset.dot)/4),behavior:'smooth'});}));
})();
</script>

{% schema %}
{
  "name":"New Arrivals",
  "settings":[
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"text","id":"heading","label":"Heading","default":"NEW ARRIVALS"},
    {"type":"range","id":"product_count","label":"Product count","min":1,"max":5,"step":1,"default":5},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"heading_size","label":"Heading size","min":16,"max":64,"step":2,"unit":"px","default":32},
    {"type":"select","id":"heading_weight","label":"Heading weight","options":[{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}],"default":"600"},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#000000"},
    {"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"range","id":"desktop_padding_top","label":"Desktop top padding","min":0,"max":120,"step":4,"unit":"px","default":48},
    {"type":"range","id":"desktop_padding_bottom","label":"Desktop bottom padding","min":0,"max":120,"step":4,"unit":"px","default":48},
    {"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":80,"step":4,"unit":"px","default":32},
    {"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":80,"step":4,"unit":"px","default":32},
    {"type":"range","id":"card_radius","label":"Card border radius","min":0,"max":24,"step":2,"unit":"px","default":8},
    {"type":"select","id":"image_ratio","label":"Image aspect ratio","options":[{"value":"2 / 3","label":"Portrait"},{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Editorial"}],"default":"2 / 3"},
    {"type":"range","id":"card_gap","label":"Card gap","min":4,"max":32,"step":4,"unit":"px","default":16},
    {"type":"range","id":"title_position","label":"Title position","min":12,"max":48,"step":4,"unit":"px","default":20},
    {"type":"range","id":"title_size","label":"Title size","min":12,"max":30,"step":2,"unit":"px","default":16},
    {"type":"select","id":"title_weight","label":"Title weight","options":[{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}],"default":"500"},
    {"type":"color","id":"title_color","label":"Title color","default":"#FFFFFF"},
    {"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":20,"max":90,"step":5,"unit":"%","default":65},
    {"type":"color","id":"dot_color","label":"Dot color","default":"#FF5A1F"}
  ],
  "presets":[{"name":"New Arrivals"}],
  "tag":null,
  "class":"new-arrivals-section"
}
{% endschema %}