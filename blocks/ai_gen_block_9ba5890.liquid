{% doc %}
  @prompt
    Create a premium, modern STYLON Discount Cards theme section for the Shopify theme editor. It must render one dedicated card for every enabled section block, with each block containing a discount text setting, Shopify collection picker, optional custom image, and enable/disable control. Show only the product image and a single centered line in the exact format “UP TO X% OFF” inside the image near the bottom. If no custom image is selected, automatically use a relevant product image from the selected collection. Use a subtle bottom-up dark gradient, white bold elegant typography, one-line text, accessible alt text, and no product names, descriptions, badges, buttons, or extra promotional copy. Make each entire card a same-tab link to its selected collection, with no visible link styling.
    
    Add highly customizable settings for an optional heading, background color, section padding/spacing, layout mode (Grid or Carousel), grid columns for desktop/tablet/mobile, card gap, carousel card width, card height or aspect ratio, border radius, image position, overlay opacity, text size, text position, and a subtle desktop hover zoom effect. Grid cards should have equal dimensions and responsive columns. Carousel cards should be horizontally scrollable, touch-friendly, smooth, scrollbar-hidden without losing usability, and prevent page-level horizontal overflow. On mobile carousel, show two complete cards plus approximately half of a third card to clearly signal swiping, while keeping text readable. On desktop carousel, show multiple balanced cards with consistent sizing and spacing. Keep the visual style minimal, premium, image-focused, fashion-forward, responsive, and scoped to this section. Use semantic keyboard-accessible links, no external dependencies, and ensure it works with Shopify theme editor and dynamic section rendering. Include sensible defaults and clean maintainable Shopify section code., add cards automatically with particular discounts
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-stylon-discounts-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background_color }};padding:{{ block.settings.section_padding }}px {{ block.settings.section_spacing }}px;overflow:hidden}.ai-stylon-discounts-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto}.ai-stylon-discounts-{{ ai_gen_id }}__heading{margin:0 0 {{ block.settings.heading_gap }}px;color:{{ block.settings.heading_color }};font-family:{{ settings.type_heading_font.family }},sans-serif;font-size:{{ block.settings.heading_size }}px;text-align:{{ block.settings.heading_alignment }}}.ai-stylon-discounts-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat({{ block.settings.desktop_columns }},minmax(0,1fr));gap:{{ block.settings.card_gap }}px}.ai-stylon-discounts-{{ ai_gen_id }}__card{position:relative;display:block;aspect-ratio:{{ block.settings.card_ratio }};overflow:hidden;border-radius:{{ block.settings.border_radius }}px;background:#292929;color:{{ block.settings.text_color }};text-decoration:none}.ai-stylon-discounts-{{ ai_gen_id }}__image,.ai-stylon-discounts-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%}.ai-stylon-discounts-{{ ai_gen_id }}__image{object-fit:cover;object-position:{{ block.settings.image_position }};transition:transform .28s ease}.ai-stylon-discounts-{{ ai_gen_id }}__card:after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by:100.0 }}),transparent 65%)}.ai-stylon-discounts-{{ ai_gen_id }}__text{position:absolute;z-index:1;right:10px;bottom:{{ block.settings.text_position }}%;left:10px;transform:translateY(50%);color:{{ block.settings.text_color }};font-family:{{ settings.type_heading_font.family }},sans-serif;font-size:{{ block.settings.text_size }}px;font-weight:700;text-align:center;white-space:nowrap}.ai-stylon-discounts-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center}.ai-stylon-discounts-{{ ai_gen_id }}__placeholder svg{width:50%;height:50%;opacity:.35}@media(hover:hover) and (min-width:750px){.ai-stylon-discounts-{{ ai_gen_id }}__card:hover .ai-stylon-discounts-{{ ai_gen_id }}__image{transform:scale({{ block.settings.hover_zoom | divided_by:100.0 }})}}@media(max-width:989px){.ai-stylon-discounts-{{ ai_gen_id }}__grid{grid-template-columns:repeat({{ block.settings.tablet_columns }},minmax(0,1fr))}}@media(max-width:749px){.ai-stylon-discounts-{{ ai_gen_id }}{padding-right:16px;padding-left:16px}.ai-stylon-discounts-{{ ai_gen_id }}__inner{width:100%}.ai-stylon-discounts-{{ ai_gen_id }}__grid{grid-template-columns:repeat({{ block.settings.mobile_columns }},minmax(0,1fr))}.ai-stylon-discounts-{{ ai_gen_id }}__text{font-size:{{ block.settings.mobile_text_size }}px}}
{% endstyle %}
<div class="ai-stylon-discounts-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-stylon-discounts-{{ ai_gen_id }}__inner">{% if block.settings.heading != blank %}<h2 class="ai-stylon-discounts-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-stylon-discounts-{{ ai_gen_id }}__grid">{% for i in (1..4) %}{% assign e='card_'|append:i|append:'_enabled' %}{% assign c='card_'|append:i|append:'_collection' %}{% assign d='card_'|append:i|append:'_discount' %}{% assign im='card_'|append:i|append:'_image' %}{% assign enabled=block.settings[e] %}{% assign collection=block.settings[c] %}{% assign image=block.settings[im] %}{% if enabled and collection != blank %}{% if image == blank and collection.products_count > 0 %}{% assign image=collection.products.first.featured_image %}{% endif %}<a class="ai-stylon-discounts-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="Up to {{ block.settings[d] }}% off from {{ collection.title | escape }}">{% if image != blank %}<img class="ai-stylon-discounts-{{ ai_gen_id }}__image" src="{{ image | image_url:width:1400 }}" alt="{{ image.alt | default:collection.title | escape }}" loading="lazy">{% else %}<div class="ai-stylon-discounts-{{ ai_gen_id }}__placeholder">{{ 'image'|placeholder_svg_tag }}</div>{% endif %}<span class="ai-stylon-discounts-{{ ai_gen_id }}__text">UP TO {{ block.settings[d] | escape }}% OFF</span></a>{% endif %}{% endfor %}</div></div></div>
{% schema %}{"name":"STYLON discount cards","settings":[{"type":"text","id":"heading","label":"Heading","default":"Signature offers"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Vertical padding","min":0,"max":100,"step":5,"unit":"px","default":30},{"type":"range","id":"section_spacing","label":"Side spacing","min":0,"max":80,"step":5,"unit":"px","default":20},{"type":"range","id":"heading_gap","label":"Heading gap","min":0,"max":50,"step":5,"unit":"px","default":20},{"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"select","id":"desktop_columns","label":"Desktop columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"},{"type":"select","id":"tablet_columns","label":"Tablet columns","options":[{"value":"1","label":"1"},{"value":"2","label":"2"},{"value":"3","label":"3"}],"default":"2"},{"type":"select","id":"mobile_columns","label":"Mobile columns","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},{"type":"range","id":"card_gap","label":"Card gap","min":0,"max":40,"step":2,"unit":"px","default":12},{"type":"select","id":"card_ratio","label":"Card aspect ratio","options":[{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"},{"value":"3 / 4","label":"Editorial"}],"default":"4 / 5"},{"type":"select","id":"image_position","label":"Image position","options":[{"value":"center center","label":"Center"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"}],"default":"center center"},{"type":"range","id":"text_position","label":"Text position","min":5,"max":35,"step":5,"unit":"%","default":15},{"type":"color","id":"background_color","label":"Background","default":"#111111"},{"type":"color","id":"heading_color","label":"Heading","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"},{"type":"range","id":"border_radius","label":"Border radius","min":0,"max":40,"step":2,"unit":"px","default":8},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":20,"max":90,"step":5,"unit":"%","default":65},{"type":"range","id":"text_size","label":"Text size","min":12,"max":48,"step":2,"unit":"px","default":24},{"type":"range","id":"hover_zoom","label":"Desktop hover zoom","min":100,"max":110,"step":1,"unit":"%","default":104},{"type":"header","content":"Cards"},{"type":"checkbox","id":"card_1_enabled","label":"Enable card 1","default":true},{"type":"text","id":"card_1_discount","label":"Card 1 discount","default":"30"},{"type":"collection","id":"card_1_collection","label":"Card 1 collection"},{"type":"image_picker","id":"card_1_image","label":"Card 1 image"},{"type":"checkbox","id":"card_2_enabled","label":"Enable card 2","default":true},{"type":"text","id":"card_2_discount","label":"Card 2 discount","default":"40"},{"type":"collection","id":"card_2_collection","label":"Card 2 collection"},{"type":"image_picker","id":"card_2_image","label":"Card 2 image"},{"type":"checkbox","id":"card_3_enabled","label":"Enable card 3","default":false},{"type":"text","id":"card_3_discount","label":"Card 3 discount","default":"50"},{"type":"collection","id":"card_3_collection","label":"Card 3 collection"},{"type":"image_picker","id":"card_3_image","label":"Card 3 image"},{"type":"checkbox","id":"card_4_enabled","label":"Enable card 4","default":false},{"type":"text","id":"card_4_discount","label":"Card 4 discount","default":"60"},{"type":"collection","id":"card_4_collection","label":"Card 4 collection"},{"type":"image_picker","id":"card_4_image","label":"Card 4 image"}],"presets":[{"name":"STYLON discount cards"}],"tag":null,"class":"stylon-discount-cards"}{% endschema %}