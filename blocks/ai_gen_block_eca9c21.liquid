{% doc %}
  @prompt
    Create a professional, modern, fashion-forward collection list section for the storefront. Allow merchants to select and display up to 10 collections. Each collection card should show only the collection image and collection title, with a clean premium visual style. Use a responsive desktop grid and a touch-friendly horizontal carousel on mobile. Include a View all button linking to the collections list page. Provide separate editable text settings for the desktop heading and button label, plus separate editable text settings for the mobile heading and button label. Include sensible spacing, typography, image cropping, and accessible controls so the section looks polished on both screen sizes., make them as card. add some small shadow. make it look modern, add solid background to view all button. dont  add any arrow in view all button. keep COLLECTION names inside image at bottom of the image. keep it look nice. , make title look modern and beautiful. keep background black overllay small at bottom. make text nice., use carusal for mobile 2 cards and 3rd card will be slihtly visible
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% assign collections_link = block.settings.collections_link | default: '/collections/all' %}{% style %}.ai-collection-list-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.section_spacing }}px 0}.ai-collection-list__header-{{ ai_gen_id }}{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.ai-collection-list__heading-{{ ai_gen_id }}{margin:0;font-family:{{ block.settings.heading_font.family }},sans-serif;font-size:{{ block.settings.heading_size }}px;color:{{ block.settings.text_color }}}.ai-collection-list__mobile-{{ ai_gen_id }}{display:none}.ai-collection-list__button-{{ ai_gen_id }}{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 18px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};border-radius:{{ block.settings.button_radius }}px;text-decoration:none;font:600 12px {{ block.settings.body_font.family }},sans-serif;text-transform:uppercase;letter-spacing:.08em}.ai-collection-list__grid-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat({{ block.settings.desktop_columns }},minmax(0,1fr));gap:{{ block.settings.card_gap }}px}.ai-collection-list__card-{{ ai_gen_id }}{display:block;overflow:hidden;position:relative;aspect-ratio:{{ block.settings.image_ratio }};border-radius:{{ block.settings.card_radius }}px;box-shadow:0 3px 12px #0000001a;text-decoration:none;scroll-snap-align:start}.ai-collection-list__card-{{ ai_gen_id }} img,.ai-collection-list__card-{{ ai_gen_id }} svg{display:block;width:100%;height:100%;object-fit:cover}.ai-collection-list__card-{{ ai_gen_id }}:after{content:'';position:absolute;inset:auto 0 0;height:38%;background:linear-gradient(transparent,#000000c9)}.ai-collection-list__title-{{ ai_gen_id }}{position:absolute;z-index:1;bottom:0;left:0;margin:0;padding:18px 14px 13px;width:100%;box-sizing:border-box;color:#fff;font:600 14px/1.25 {{ block.settings.body_font.family }},sans-serif;letter-spacing:.05em;text-transform:uppercase;text-shadow:0 1px 5px #0006}.ai-collection-list__controls-{{ ai_gen_id }}{display:none}@media(max-width:749px){.ai-collection-list-{{ ai_gen_id }}{padding:{{ block.settings.mobile_spacing }}px 0}.ai-collection-list__desktop-{{ ai_gen_id }}{display:none}.ai-collection-list__mobile-{{ ai_gen_id }}{display:block}.ai-collection-list__heading-{{ ai_gen_id }}{font-size:{{ block.settings.mobile_heading_size }}px}.ai-collection-list__button-{{ ai_gen_id }}{min-height:38px;padding:0 13px;font-size:10px}.ai-collection-list__grid-{{ ai_gen_id }}{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:2px 2px 10px}.ai-collection-list__grid-{{ ai_gen_id }}::-webkit-scrollbar{display:none}.ai-collection-list__card-{{ ai_gen_id }}{flex:0 0 44%}.ai-collection-list__controls-{{ ai_gen_id }}{display:none}}{% endstyle %}<collection-list-{{ ai_gen_id }} class="ai-collection-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-collection-list__header-{{ ai_gen_id }}"><h2 class="ai-collection-list__heading-{{ ai_gen_id }} ai-collection-list__desktop-{{ ai_gen_id }}">{{ block.settings.desktop_heading }}</h2><h2 class="ai-collection-list__heading-{{ ai_gen_id }} ai-collection-list__mobile-{{ ai_gen_id }}">{{ block.settings.mobile_heading }}</h2><a class="ai-collection-list__button-{{ ai_gen_id }}" href="{{ collections_link }}"><span class="ai-collection-list__desktop-{{ ai_gen_id }}">{{ block.settings.desktop_button_label }}</span><span class="ai-collection-list__mobile-{{ ai_gen_id }}">{{ block.settings.mobile_button_label }}</span></a></div><div class="ai-collection-list__grid-{{ ai_gen_id }}">{% for collection in block.settings.collections %}<a class="ai-collection-list__card-{{ ai_gen_id }}" href="{{ collection.url }}">{% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width: 1200 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="1200" height="1200">{% else %}{{ 'collection-apparel-1' | placeholder_svg_tag }}{% endif %}<h3 class="ai-collection-list__title-{{ ai_gen_id }}">{{ collection.title }}</h3></a>{% endfor %}</div></collection-list-{{ ai_gen_id }}>{% schema %}{"name":"Collection list","tag":null,"class":"collection-list-block","settings":[{"type":"collection_list","id":"collections","label":"Collections","limit":10},{"type":"text","id":"desktop_heading","label":"Desktop heading","default":"Explore our collections"},{"type":"text","id":"mobile_heading","label":"Mobile heading","default":"Shop collections"},{"type":"text","id":"desktop_button_label","label":"Desktop button label","default":"View all"},{"type":"text","id":"mobile_button_label","label":"Mobile button label","default":"View all"},{"type":"url","id":"collections_link","label":"Collections page"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"desktop_columns","label":"Desktop columns","options":[{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}],"default":"4"},{"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"1 / 1","label":"Square"},{"value":"3 / 4","label":"Portrait"},{"value":"4 / 5","label":"Editorial"}],"default":"4 / 5"},{"type":"range","id":"card_gap","label":"Card gap","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":24,"step":2,"unit":"px","default":6},{"type":"range","id":"section_spacing","label":"Desktop spacing","min":16,"max":96,"step":8,"unit":"px","default":48},{"type":"range","id":"mobile_spacing","label":"Mobile spacing","min":16,"max":64,"step":8,"unit":"px","default":32},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},{"type":"font_picker","id":"body_font","label":"Body font","default":"inter_n4"},{"type":"range","id":"heading_size","label":"Desktop heading size","min":20,"max":56,"step":2,"unit":"px","default":32},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":18,"max":36,"step":2,"unit":"px","default":24},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"button_background","label":"Button background","default":"#000000"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":4}],"presets":[{"name":"Collection list"}]}{% endschema %}