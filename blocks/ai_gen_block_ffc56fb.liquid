{% doc %}
  @prompt
    Create a premium, modern, responsive Shopify theme section for the STYLON store called “New Arrivals”. The section must automatically display only the 10 latest products, sorted by newest product creation date, with no manual product selection, so it updates as new products are added. Display the products in a smooth horizontal carousel/slider. Each clickable product card must link to the product page and show only the product image, product title, and product price. Do not show descriptions, vendor, reviews, wishlist, quantity, buttons, or any other extra information. If a product is on sale, show a clean compact “X% OFF” badge at the top-right of the product image, dynamically calculated from compare-at price and current selling price, and hide it when there is no valid sale. On desktop, show 5 fully visible cards with consistent widths, equal spacing, aligned image aspect ratios, and intuitive navigation controls. On mobile, show 2 fully visible cards plus approximately one partially visible third card on the right to indicate horizontal swipeability, without page-level horizontal overflow. Make the carousel touch-friendly and smooth. Use a minimal, elegant, fashion-focused premium design matching STYLON: white product titles and a contrasting premium price color that works with the brand accent #FF5A1F. Keep titles to exactly one line with truncation or ellipsis, and keep prices consistently aligned. Show the compare-at price immediately after the current price using a clear strikethrough style, only when it is higher than the current price. Ensure the section is responsive across screen sizes and browser zoom levels, resizes smoothly, preserves layout integrity, and is fully compatible with the Shopify theme editor with sensible customizable settings such as heading text, colors, spacing, image aspect ratio, and navigation visibility. Use Shopify Liquid, HTML, CSS, and JavaScript as appropriate, and keep all product data, images, prices, links, and discount percentages dynamic rather than hard-coded., carusal arrows are not visible
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign new_arrivals_products = collections.all.products | sort: 'created_at' | reverse %}
{% style %}
.ai-new-arrivals-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background_color }};padding:{{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;overflow:hidden}.ai-new-arrivals-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto}.ai-new-arrivals-{{ ai_gen_id }}__header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:{{ block.settings.heading_gap }}px}.ai-new-arrivals-{{ ai_gen_id }}__heading{margin:0;color:{{ block.settings.title_color }};font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.heading_size }}px;line-height:1.1}.ai-new-arrivals-{{ ai_gen_id }}__controls{display:flex!important;align-items:center;gap:10px;position:relative;z-index:5}.ai-new-arrivals-{{ ai_gen_id }}__button{appearance:none!important;-webkit-appearance:none!important;display:grid!important;place-items:center!important;width:42px!important;height:42px!important;min-width:42px!important;padding:0!important;border:1px solid {{ block.settings.control_color }}!important;border-radius:50%!important;background:{{ block.settings.background_color }}!important;color:{{ block.settings.control_color }}!important;cursor:pointer!important;line-height:1!important}.ai-new-arrivals-{{ ai_gen_id }}__button svg{display:block!important;width:20px!important;height:20px!important;stroke:currentColor!important;fill:none!important}.ai-new-arrivals-{{ ai_gen_id }}__button:disabled{opacity:.35!important;cursor:not-allowed!important}.ai-new-arrivals-{{ ai_gen_id }}__button:focus-visible{outline:2px solid {{ block.settings.accent_color }};outline-offset:3px}.ai-new-arrivals-{{ ai_gen_id }}__track{display:flex;gap:{{ block.settings.card_gap }}px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:4px}.ai-new-arrivals-{{ ai_gen_id }}__track::-webkit-scrollbar{display:none}.ai-new-arrivals-{{ ai_gen_id }}__card{flex:0 0 calc((100% - ({{ block.settings.card_gap }}px * 4))/5);min-width:0;scroll-snap-align:start;text-decoration:none;color:inherit}.ai-new-arrivals-{{ ai_gen_id }}__media{position:relative;overflow:hidden;aspect-ratio:{{ block.settings.image_ratio }};background:#f2f2f2}.ai-new-arrivals-{{ ai_gen_id }}__media img,.ai-new-arrivals-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;display:block;object-fit:cover}.ai-new-arrivals-{{ ai_gen_id }}__media img{transition:transform .35s ease}.ai-new-arrivals-{{ ai_gen_id }}__card:hover .ai-new-arrivals-{{ ai_gen_id }}__media img{transform:scale(1.025)}.ai-new-arrivals-{{ ai_gen_id }}__badge{position:absolute;top:10px;right:10px;padding:6px 8px;background:{{ block.settings.badge_color }};color:{{ block.settings.badge_text_color }};font-size:10px;font-weight:700;letter-spacing:.08em}.ai-new-arrivals-{{ ai_gen_id }}__info{padding-top:12px}.ai-new-arrivals-{{ ai_gen_id }}__name{margin:0 0 7px;color:{{ block.settings.title_color }};font-family:{{ block.settings.body_font.family }};font-size:{{ block.settings.title_size }}px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ai-new-arrivals-{{ ai_gen_id }}__prices{display:flex;align-items:baseline;gap:8px;min-height:20px;font-family:{{ block.settings.body_font.family }}}.ai-new-arrivals-{{ ai_gen_id }}__price{color:{{ block.settings.accent_color }};font-size:{{ block.settings.price_size }}px;font-weight:700}.ai-new-arrivals-{{ ai_gen_id }}__compare{color:{{ block.settings.compare_color }};font-size:{{ block.settings.compare_size }}px;text-decoration:line-through}@media(max-width:749px){.ai-new-arrivals-{{ ai_gen_id }}{padding-top:{{ block.settings.mobile_padding_top }}px;padding-bottom:{{ block.settings.mobile_padding_bottom }}px}.ai-new-arrivals-{{ ai_gen_id }}__inner{width:100%;padding:0 16px}.ai-new-arrivals-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}.ai-new-arrivals-{{ ai_gen_id }}__card{flex-basis:calc((100% - {{ block.settings.mobile_card_gap }}px)/2.35)}.ai-new-arrivals-{{ ai_gen_id }}__track{gap:{{ block.settings.mobile_card_gap }}px}.ai-new-arrivals-{{ ai_gen_id }}__controls{display:none!important}}
{% endstyle %}
<new-arrivals-{{ ai_gen_id }} class="ai-new-arrivals-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-new-arrivals-{{ ai_gen_id }}__inner"><div class="ai-new-arrivals-{{ ai_gen_id }}__header"><h2 class="ai-new-arrivals-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% if block.settings.show_navigation %}<div class="ai-new-arrivals-{{ ai_gen_id }}__controls"><button class="ai-new-arrivals-{{ ai_gen_id }}__button" type="button" data-direction="prev" aria-label="Previous products"><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg></button><button class="ai-new-arrivals-{{ ai_gen_id }}__button" type="button" data-direction="next" aria-label="Next products"><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></button></div>{% endif %}</div><div class="ai-new-arrivals-{{ ai_gen_id }}__track" tabindex="0">{% for product in new_arrivals_products limit:10 %}{% assign variant=product.selected_or_first_available_variant %}{% assign compare_price=variant.compare_at_price %}{% assign current_price=variant.price %}{% if compare_price and compare_price > current_price %}{% assign discount_amount=compare_price | minus:current_price %}{% assign discount_percent=discount_amount | times:100 | divided_by:compare_price | round %}{% endif %}<a class="ai-new-arrivals-{{ ai_gen_id }}__card" href="{{ product.url }}"><div class="ai-new-arrivals-{{ ai_gen_id }}__media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width:900 }}" alt="{{ product.featured_image.alt | default:product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div class="ai-new-arrivals-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}{% if discount_percent %}<span class="ai-new-arrivals-{{ ai_gen_id }}__badge">{{ discount_percent }}% OFF</span>{% endif %}</div><div class="ai-new-arrivals-{{ ai_gen_id }}__info"><p class="ai-new-arrivals-{{ ai_gen_id }}__name">{{ product.title | escape }}</p><div class="ai-new-arrivals-{{ ai_gen_id }}__prices"><span class="ai-new-arrivals-{{ ai_gen_id }}__price">{{ current_price | money }}</span>{% if compare_price and compare_price > current_price %}<span class="ai-new-arrivals-{{ ai_gen_id }}__compare">{{ compare_price | money }}</span>{% endif %}</div></div></a>{% endfor %}</div></div></new-arrivals-{{ ai_gen_id }}>
<script>(function(){class NewArrivals{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('.ai-new-arrivals-{{ ai_gen_id }}__track');this.buttons=this.querySelectorAll('[data-direction]');this.buttons.forEach(b=>b.addEventListener('click',()=>this.move(b.dataset.direction)));this.update();this.track.addEventListener('scroll',()=>this.update(),{passive:true});window.addEventListener('resize',()=>this.update())}move(d){this.track.scrollBy({left:(d==='next'?1:-1)*this.track.clientWidth*.82,behavior:'smooth'})}update(){if(!this.track)return;this.buttons.forEach(b=>b.disabled=b.dataset.direction==='prev'?this.track.scrollLeft<=4:this.track.scrollLeft+this.track.clientWidth>=this.track.scrollWidth-4)}}customElements.define('new-arrivals-{{ ai_gen_id }}',NewArrivals{{ ai_gen_id }})})();</script>
{% schema %}{"name":"New arrivals","tag":null,"class":"new-arrivals-block","settings":[{"type":"text","id":"heading","label":"Heading","default":"New Arrivals"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},{"type":"font_picker","id":"body_font","label":"Body font","default":"inter_n4"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"3 / 4","label":"Portrait"},{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Editorial"}],"default":"3 / 4"},{"type":"checkbox","id":"show_navigation","label":"Show navigation","default":true},{"type":"range","id":"heading_size","label":"Heading size","min":16,"max":48,"step":2,"unit":"px","default":32},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":14,"max":32,"step":2,"unit":"px","default":24},{"type":"range","id":"title_size","label":"Title size","min":10,"max":20,"step":1,"unit":"px","default":13},{"type":"range","id":"price_size","label":"Price size","min":10,"max":22,"step":1,"unit":"px","default":14},{"type":"range","id":"compare_size","label":"Compare price size","min":10,"max":18,"step":1,"unit":"px","default":12},{"type":"range","id":"card_gap","label":"Card gap","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"mobile_card_gap","label":"Mobile card gap","min":8,"max":24,"step":2,"unit":"px","default":12},{"type":"range","id":"heading_gap","label":"Heading spacing","min":12,"max":48,"step":4,"unit":"px","default":24},{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":8,"unit":"px","default":56},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":8,"unit":"px","default":56},{"type":"range","id":"mobile_padding_top","label":"Mobile top spacing","min":0,"max":80,"step":8,"unit":"px","default":32},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom spacing","min":0,"max":80,"step":8,"unit":"px","default":32},{"type":"color","id":"background_color","label":"Background","default":"#000000"},{"type":"color","id":"title_color","label":"Title","default":"#FFFFFF"},{"type":"color","id":"accent_color","label":"Price","default":"#FF5A1F"},{"type":"color","id":"compare_color","label":"Compare price","default":"#BDBDBD"},{"type":"color","id":"control_color","label":"Navigation","default":"#FFFFFF"},{"type":"color","id":"badge_color","label":"Sale badge","default":"#FF5A1F"},{"type":"color","id":"badge_text_color","label":"Badge text","default":"#FFFFFF"}],"presets":[{"name":"New arrivals"}]}{% endschema %}