
<!-- BEGIN USF -->
{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}
<!--begin usf settings-->
{% assign settings = block.settings %}
{% capture blockStyle %}
  {% render 'border-override', settings: block.settings %}
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
{% endcapture %}
{% capture blockClass %}
  group-block
    group-block--height-{{ block.settings.height }}
    group-block--width-{{ block.settings.width }}
    border-style
    spacing-style
    size-style
    {% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }}{% endif %}
    {{ class }}
{% endcapture %}
{% capture groupMedia %}
  {% render 'background-media',
      background_media: block.settings.background_media,
      background_video: block.settings.video,
      background_video_position: block.settings.video_position,
      background_image: block.settings.background_image,
      background_image_position: block.settings.background_image_position,
      placeholder: block.settings.placeholder
    %}
    {% if settings.toggle_overlay %}
      {% render 'overlay', settings: settings, layer: '0' %}
    {% endif %}
{% endcapture %}
{% capture groupContentClass %}
  group-block-content
      {% if request.design_mode %}group-block-content--design-mode{% endif %}
      layout-panel-flex
      layout-panel-flex--{{ settings.content_direction | default: 'column' }}
      {% if settings.vertical_on_mobile %} mobile-column{% endif %}
{% endcapture %}
{% capture groupContentStyle %}{% render 'layout-panel-style', settings: settings %}{% endcapture %}
<script>
if (window._usfGetSettings) {
  const _currentBlockId = {{ block.id | json }};
  const groupSettings = {
      blockStyle: {{ blockStyle | strip_newlines | json }},
      blockClass: {{ blockClass | strip_newlines | json }},
      groupContentClass: {{ groupContentClass | strip_newlines | json }},
      groupContentStyle: {{ groupContentStyle | strip_newlines | json }},
      groupMedia: {{ groupMedia | json }},
      link: {{ block.settings.link | json }},
      open_in_new_tab: {{ block.settings.open_in_new_tab | json }},
  };
    const childBlocks = [
    {% if block.blocks and block.blocks.size > 0 %}
      {% for bl in block.blocks %}
        { id: {{ bl.id | remove: '-1' | json }} },
      {% endfor %}
    {% endif %}
  ];
  _usfGridBlocks.some(parent => {
    if (parent.id === _currentBlockId) {
      parent.name = "group";
      parent.settings = groupSettings;
      parent.blocks = childBlocks
      return true;
    }
    return parent.blocks?.some(child => {

      if (child.id === _currentBlockId) {
        child.name = "group";
        child.settings = groupSettings;
        child.blocks = childBlocks
        return true;
      }
      return child.blocks?.some(grand => {
        if (grand.id === _currentBlockId) {
          grand.name = "group";
          grand.settings = groupSettings;
          grand.blocks = childBlocks
          return true;
        }
      });
    });
  });
}
</script>
<!--end usf settings-->
{% render 'group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}
<!-- END USF -->

{% comment %}USF






{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}




