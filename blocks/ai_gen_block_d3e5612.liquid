{% doc %}
  @prompt
    Create a premium, modern ecommerce collection section featuring clean collection cards with high-quality images and stylish, clearly visible collection titles below each image. Make the cards elegant and professional with subtle rounded corners, balanced spacing, consistent image proportions, and a refined luxury-fashion aesthetic. Make the collection titles modern, clean, and visually appealing with strong typography and proper spacing.
    
    Add customizable left and right padding settings (in pixels) for the section, with both left padding and right padding defaulting to 0 so the collection cards align perfectly with other full-width sections.
    
    The layout should be clean, responsive, well-aligned, and easy to browse. Use a subtle, refined hover effect (e.g. slight image zoom or soft shadow lift) — avoid excessive effects and bouncy animations. Cards should display in a responsive grid (e.g. 4 columns on desktop, 2 on tablet, 1-2 on mobile). Include a section heading option. Keep the overall aesthetic luxury-fashion: dark tones, gold or neutral accents, minimal and editorial feel., add collection item select option instead of harcoding collection. , desktop should show 5 cards , tablet 4 and mobile 2, keep title little small and dont bounce cards on hover effedt. make title golden on hover and zoom image.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_right }}px {{ block.settings.section_padding_bottom }}px {{ block.settings.section_padding_left }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-luxury-collection-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-luxury-collection-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-luxury-collection-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 400;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    text-transform: {% if block.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
  }

  .ai-luxury-collection-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_spacing }}px;
  }

  .ai-luxury-collection-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-luxury-collection-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-luxury-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px {{ block.settings.card_border_radius }}px 0 0;
    background-color: #f4f4f4;
  }

  .ai-luxury-collection-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .ai-luxury-collection-card-{{ ai_gen_id }}:hover .ai-luxury-collection-image-{{ ai_gen_id }} {
    transform: scale(1.08);
  }

  .ai-luxury-collection-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-luxury-collection-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-luxury-collection-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_content_padding }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-luxury-collection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: {{ block.settings.title_weight }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: {% if block.settings.title_uppercase %}uppercase{% else %}none{% endif %};
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .ai-luxury-collection-card-{{ ai_gen_id }}:hover .ai-luxury-collection-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_hover_color }};
  }

  .ai-luxury-collection-count-{{ ai_gen_id }} {
    display: {% if block.settings.show_product_count %}block{% else %}none{% endif %};
    font-size: {{ block.settings.count_size }}px;
    color: {{ block.settings.count_color }};
    margin-top: 8px;
    font-weight: 300;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 989px) {
    .ai-luxury-collection-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: {{ block.settings.card_spacing | times: 0.8 }}px;
    }

    .ai-luxury-collection-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }

    .ai-luxury-collection-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-luxury-collection-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px {{ block.settings.section_padding_right | times: 0.5 }}px {{ block.settings.section_padding_bottom | times: 0.6 }}px {{ block.settings.section_padding_left | times: 0.5 }}px;
    }

    .ai-luxury-collection-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.card_spacing | times: 0.6 }}px;
    }

    .ai-luxury-collection-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-luxury-collection-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.75 }}px;
    }

    .ai-luxury-collection-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_content_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-luxury-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-collection-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-luxury-collection-header-{{ ai_gen_id }}">
        <h2 class="ai-luxury-collection-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="ai-luxury-collection-grid-{{ ai_gen_id }}">
      {% if block.settings.collection_list != blank %}
        {% for collection in block.settings.collection_list %}
          <div class="ai-luxury-collection-card-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-luxury-collection-link-{{ ai_gen_id }}">
              <div class="ai-luxury-collection-image-wrapper-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-luxury-collection-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                  >
                {% else %}
                  <div class="ai-luxury-collection-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-luxury-collection-card-content-{{ ai_gen_id }}">
                <h3 class="ai-luxury-collection-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                {% if block.settings.show_product_count %}
                  <div class="ai-luxury-collection-count-{{ ai_gen_id }}">
                    {{ collection.products_count }}
                    {% if collection.products_count == 1 %}
                      {{ block.settings.product_count_singular }}
                    {% else %}
                      {{ block.settings.product_count_plural }}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

