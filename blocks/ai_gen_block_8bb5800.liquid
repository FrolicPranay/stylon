{% doc %}
  @prompt
    Create a horizontally scrollable hero banner section with auto-sliding carousel that slides to the left. It should display 3 banners, each with a full-width background image, overlay text (heading and subheading), and a call-to-action button. The banners should auto-scroll left with a smooth transition, and include navigation dots or arrows. Style should match a dark luxury premium fashion brand with elegant typography and gold accent details.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-hero-carousel-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .ai-hero-carousel-slide-{{ ai_gen_id }} {
    min-width: 100%;
    position: relative;
    height: {{ block.settings.slide_height_desktop }}px;
  }

  .ai-hero-carousel-slide-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-hero-carousel-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-carousel-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .ai-hero-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 16px 32px;
    font-size: 14px;
    color: {{ block.settings.overlay_text_color }};
    text-align: center;
    pointer-events: none;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
  }

  .ai-hero-carousel-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 | times: 0.7 }}) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    padding: 60px 40px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-hero-carousel-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    z-index: 1;
  }

  .ai-hero-carousel-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.overlay_text_color }};
    margin: 0 0 16px;
    font-weight: 400;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: 1.2;
  }

  .ai-hero-carousel-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.overlay_text_color }};
    margin: 0 0 32px;
    font-weight: 300;
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    line-height: 1.5;
    opacity: 0.9;
  }

  .ai-hero-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 48px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    text-transform: uppercase;
  }

  .ai-hero-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(201, 146, 42, 0.3);
  }

  .ai-hero-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 2;
  }

  .ai-hero-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.overlay_text_color }};
    opacity: 0.4;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid {{ block.settings.button_background_color }};
  }

  .ai-hero-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
    background-color: {{ block.settings.button_background_color }};
    transform: scale(1.2);
  }

  .ai-hero-carousel-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(0, 0, 0, 0.5);
    color: {{ block.settings.overlay_text_color }};
    border: 1px solid {{ block.settings.button_background_color }};
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .ai-hero-carousel-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_background_color }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-hero-carousel-arrow-{{ ai_gen_id }}--prev {
    left: 20px;
  }

  .ai-hero-carousel-arrow-{{ ai_gen_id }}--next {
    right: 20px;
  }

  .ai-hero-carousel-arrow-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-carousel-slide-{{ ai_gen_id }} {
      height: {{ block.settings.slide_height_mobile }}px;
    }

    .ai-hero-carousel-overlay-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-hero-carousel-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-hero-carousel-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
      margin-bottom: 24px;
    }

    .ai-hero-carousel-button-{{ ai_gen_id }} {
      padding: 12px 32px;
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }

    .ai-hero-carousel-arrow-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-hero-carousel-arrow-{{ ai_gen_id }}--prev {
      left: 10px;
    }

    .ai-hero-carousel-arrow-{{ ai_gen_id }}--next {
      right: 10px;
    }

    .ai-hero-carousel-nav-{{ ai_gen_id }} {
      bottom: 20px;
    }
  }
{% endstyle %}

<hero-carousel-{{ ai_gen_id }} class="ai-hero-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-carousel-track-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'slide_' | append: i | append: '_image'
        assign heading_key = 'slide_' | append: i | append: '_heading'
        assign subheading_key = 'slide_' | append: i | append: '_subheading'
        assign button_text_key = 'slide_' | append: i | append: '_button_text'
        assign button_link_key = 'slide_' | append: i | append: '_button_link'

        assign slide_image = block.settings[image_key]
        assign slide_heading = block.settings[heading_key]
        assign slide_subheading = block.settings[subheading_key]
        assign slide_button_text = block.settings[button_text_key]
        assign slide_button_link = block.settings[button_link_key]
      %}

      <div class="ai-hero-carousel-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
        {% if slide_image %}
          <img
            src="{{ slide_image | image_url: width: 2000 }}"
            alt="{{ slide_image.alt | escape }}"
            loading="lazy"
            width="{{ slide_image.width }}"
            height="{{ slide_image.height }}"
            class="ai-hero-carousel-slide-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-hero-carousel-slide-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            {% if i == 1 %}
              <div class="ai-hero-carousel-empty-state-{{ ai_gen_id }}">
                Add images to create your luxury carousel
              </div>
            {% endif %}
          </div>
        {% endif %}

        <div class="ai-hero-carousel-overlay-{{ ai_gen_id }}">
          <div class="ai-hero-carousel-content-{{ ai_gen_id }}">
            {% if slide_heading != blank %}
              <h2 class="ai-hero-carousel-heading-{{ ai_gen_id }}">{{ slide_heading }}</h2>
            {% endif %}

            {% if slide_subheading != blank %}
              <p class="ai-hero-carousel-subheading-{{ ai_gen_id }}">{{ slide_subheading }}</p>
            {% endif %}

            {% if slide_button_text != blank and slide_button_link != blank %}
              <a href="{{ slide_button_link }}" class="ai-hero-carousel-button-{{ ai_gen_id }}">
                {{ slide_button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if block.settings.show_arrows %}
    <button class="ai-hero-carousel-arrow-{{ ai_gen_id }} ai-hero-carousel-arrow-{{ ai_gen_id }}--prev" aria-label="Previous slide">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button class="ai-hero-carousel-arrow-{{ ai_gen_id }} ai-hero-carousel-arrow-{{ ai_gen_id }}--next" aria-label="Next slide">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  {% endif %}

  {% if block.settings.show_dots %}
    <div class="ai-hero-carousel-nav-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        <button class="ai-hero-carousel-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-slide="{{ i }}" aria-label="Go to slide {{ i }}"></button>
      {% endfor %}
    </div>
  {% endif %}
</hero-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 3;
        this.autoplayInterval = {{ block.settings.autoplay_speed }} * 1000;
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-hero-carousel-track-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-hero-carousel-dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-hero-carousel-arrow-{{ ai_gen_id }}--prev');
        this.nextButton = this.querySelector('.ai-hero-carousel-arrow-{{ ai_gen_id }}--next');

        this.setupEventListeners();
        
        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.goToPrevSlide();
            this.resetAutoplay();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.goToNextSlide();
            this.resetAutoplay();
          });
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            this.resetAutoplay();
          });
        });

        this.addEventListener('mouseenter', () => {
          if (this.autoplayTimer) {
            clearInterval(this.autoplayTimer);
          }
        });

        this.addEventListener('mouseleave', () => {
          {% if block.settings.autoplay %}
            this.startAutoplay();
          {% endif %}
        });
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateCarousel();
      }

      goToNextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
        this.updateCarousel();
      }

      goToPrevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.updateCarousel();
      }

      updateCarousel() {
        const offset = -this.currentSlide * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        this.autoplayTimer = setInterval(() => {
          this.goToNextSlide();
        }, this.autoplayInterval);
      }

      resetAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
        }
        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      disconnectedCallback() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
        }
      }
    }

    customElements.define('hero-carousel-{{ ai_gen_id }}', HeroCarousel{{ ai_gen_id }});
  })();
</script>

