{% doc %}
  @prompt
    Create a polished, premium responsive collection list section for STYLON. On desktop, display exactly 5 collection cards in 5 columns in one row. On mobile, turn the collection list into a swipeable carousel that shows 2 collection cards fully at a time, with the third collection card slightly visible as a partial preview on the right. Include accessible swipe and navigation behavior, responsive spacing, and a clean elegant design consistent with a women's Indian ethnic fashion storefront. Each collection card should use the selected collection's image and title and link to that collection., make titles good and modern, remove the golden line. please make this look modern and fashionable, i can show upto 10 here. give me view all button at top right. also remove the description line, remove the crausal arrows from top right and add view all button with solid background just like other sections, make it crausable on desktop as well. give option .crausal or gird, show arrows when crausal, arrows should be on card side becase view all button will be at top right, please be smart show crasal when user hover. use orange crausal arrows background just like other sections. make crasaul jsut liek other sections
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-collection-list-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }}}.ai-collection-list-{{ ai_gen_id }}__header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:{{ block.settings.header_spacing }}px}.ai-collection-list-{{ ai_gen_id }}__heading{margin:0;font-size:{{ block.settings.heading_size }}px;line-height:1.05;letter-spacing:-.045em;font-weight:700}.ai-collection-list-{{ ai_gen_id }}__view-all{display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border:0;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text }};font-size:11px;font-weight:600;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.ai-collection-list-{{ ai_gen_id }}__view-all:hover{opacity:.78}.ai-collection-list-{{ ai_gen_id }}__viewport{position:relative}.ai-collection-list-{{ ai_gen_id }}__track{gap:{{ block.settings.card_gap }}px}.ai-collection-list-{{ ai_gen_id }}__track--grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}.ai-collection-list-{{ ai_gen_id }}__track--carousel{display:flex;overflow-x:auto;padding-bottom:10px;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;scrollbar-width:none;-webkit-overflow-scrolling:touch}.ai-collection-list-{{ ai_gen_id }}__track--carousel::-webkit-scrollbar{display:none}.ai-collection-list-{{ ai_gen_id }}__track--carousel .ai-collection-list-{{ ai_gen_id }}__card{flex:0 0 calc((100% - (4 * {{ block.settings.card_gap }}px))/5);scroll-snap-align:start}.ai-collection-list-{{ ai_gen_id }}__card{min-width:0}.ai-collection-list-{{ ai_gen_id }}__card-link{display:block;color:inherit;text-decoration:none}.ai-collection-list-{{ ai_gen_id }}__media{position:relative;overflow:hidden;aspect-ratio:.78;background:{{ block.settings.placeholder_background }};border-radius:{{ block.settings.card_radius }}px}.ai-collection-list-{{ ai_gen_id }}__media img,.ai-collection-list-{{ ai_gen_id }}__media svg{display:block;width:100%;height:100%;object-fit:cover}.ai-collection-list-{{ ai_gen_id }}__media img{transition:transform 300ms ease}.ai-collection-list-{{ ai_gen_id }}__card-link:hover .ai-collection-list-{{ ai_gen_id }}__media img{transform:scale(1.03)}.ai-collection-list-{{ ai_gen_id }}__placeholder-copy{position:absolute;right:12px;bottom:12px;left:12px;color:{{ block.settings.muted_text_color }};font-size:11px;text-align:center}.ai-collection-list-{{ ai_gen_id }}__title{margin:15px 0 0;font-size:13px;line-height:1.35;font-weight:600;letter-spacing:.08em;text-transform:uppercase;text-align:left}.ai-collection-list-{{ ai_gen_id }}__arrow{position:absolute;top:42%;z-index:2;display:flex;align-items:center;justify-content:center;width:40px;height:40px;padding:0;border:0;border-radius:50%;background:#ff5a1f;color:#fff;box-shadow:0 4px 14px rgba(0,0,0,.18);cursor:pointer;font-size:18px;line-height:1;opacity:0;pointer-events:none;transform:translateY(-50%);transition:opacity 180ms ease}.ai-collection-list-{{ ai_gen_id }}__viewport:hover .ai-collection-list-{{ ai_gen_id }}__arrow,.ai-collection-list-{{ ai_gen_id }}__arrow:focus-visible{opacity:1;pointer-events:auto}.ai-collection-list-{{ ai_gen_id }}__arrow--previous{left:10px}.ai-collection-list-{{ ai_gen_id }}__arrow--next{right:10px}.ai-collection-list-{{ ai_gen_id }}__arrow:hover{background:#d94712}.ai-collection-list-{{ ai_gen_id }}__view-all:focus-visible,.ai-collection-list-{{ ai_gen_id }}__arrow:focus-visible,.ai-collection-list-{{ ai_gen_id }}__card-link:focus-visible{outline:2px solid {{ block.settings.text_color }};outline-offset:3px}
@media screen and (max-width:749px){.ai-collection-list-{{ ai_gen_id }}{width:100%}.ai-collection-list-{{ ai_gen_id }}__header{margin-bottom:20px}.ai-collection-list-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}.ai-collection-list-{{ ai_gen_id }}__view-all{padding:10px 13px;font-size:10px}.ai-collection-list-{{ ai_gen_id }}__arrow{width:34px;height:34px;opacity:1;pointer-events:auto}.ai-collection-list-{{ ai_gen_id }}__arrow--previous{left:7px}.ai-collection-list-{{ ai_gen_id }}__arrow--next{right:7px}.ai-collection-list-{{ ai_gen_id }}__track--grid,.ai-collection-list-{{ ai_gen_id }}__track--carousel{display:flex;gap:{{ block.settings.mobile_card_gap }}px;overflow-x:auto;padding:0 12% 10px 0;scroll-snap-type:x mandatory;scrollbar-width:none}.ai-collection-list-{{ ai_gen_id }}__track--grid::-webkit-scrollbar,.ai-collection-list-{{ ai_gen_id }}__track--carousel::-webkit-scrollbar{display:none}.ai-collection-list-{{ ai_gen_id }}__track--grid .ai-collection-list-{{ ai_gen_id }}__card,.ai-collection-list-{{ ai_gen_id }}__track--carousel .ai-collection-list-{{ ai_gen_id }}__card{flex:0 0 calc((100% - {{ block.settings.mobile_card_gap }}px)/2);scroll-snap-align:start}.ai-collection-list-{{ ai_gen_id }}__title{margin-top:12px;font-size:11px;letter-spacing:.07em}}
{% endstyle %}
<collection-list-{{ ai_gen_id }} class="ai-collection-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-collection-list-{{ ai_gen_id }}__header"><h2 class="ai-collection-list-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% if block.settings.view_all_link != blank %}<a class="ai-collection-list-{{ ai_gen_id }}__view-all" href="{{ block.settings.view_all_link }}">View all <span aria-hidden="true">&#8594;</span></a>{% endif %}</div><div class="ai-collection-list-{{ ai_gen_id }}__viewport">{% if block.settings.layout_mode == 'carousel' %}<button type="button" class="ai-collection-list-{{ ai_gen_id }}__arrow ai-collection-list-{{ ai_gen_id }}__arrow--previous" data-direction="previous" aria-label="Previous collections">&#8592;</button><button type="button" class="ai-collection-list-{{ ai_gen_id }}__arrow ai-collection-list-{{ ai_gen_id }}__arrow--next" data-direction="next" aria-label="Next collections">&#8594;</button>{% endif %}<div class="ai-collection-list-{{ ai_gen_id }}__track ai-collection-list-{{ ai_gen_id }}__track--{{ block.settings.layout_mode }}" tabindex="0" aria-label="Collections">{% for collection in block.settings.collections %}<article class="ai-collection-list-{{ ai_gen_id }}__card"><a class="ai-collection-list-{{ ai_gen_id }}__card-link" href="{{ collection.url }}" aria-label="Explore {{ collection.title | escape }} collection"><div class="ai-collection-list-{{ ai_gen_id }}__media">{% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="900" height="1154">{% else %}{{ 'collection-apparel-1' | placeholder_svg_tag }}<span class="ai-collection-list-{{ ai_gen_id }}__placeholder-copy">Add a collection image</span>{% endif %}</div><h3 class="ai-collection-list-{{ ai_gen_id }}__title">{{ collection.title | escape }}</h3></a></article>{% endfor %}</div></div></collection-list-{{ ai_gen_id }}>
<script>(function(){class CollectionList{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('.ai-collection-list-{{ ai_gen_id }}__track');this.querySelectorAll('[data-direction]').forEach((button)=>button.addEventListener('click',()=>{var card=this.track.querySelector('.ai-collection-list-{{ ai_gen_id }}__card');var distance=card?card.getBoundingClientRect().width+{{ block.settings.card_gap }}:300;this.track.scrollBy({left:button.dataset.direction==='next'?distance:-distance,behavior:'smooth'})}))}}if(!customElements.get('collection-list-{{ ai_gen_id }}'))customElements.define('collection-list-{{ ai_gen_id }}',CollectionList{{ ai_gen_id }});})();</script>
{% schema %}{"name":"Modern collection list","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"Explore the edit"},{"type":"url","id":"view_all_link","label":"View all link"},{"type":"collection_list","id":"collections","label":"Collections","limit":10},{"type":"header","content":"Layout"},{"type":"select","id":"layout_mode","label":"Desktop layout","options":[{"value":"grid","label":"Grid"},{"value":"carousel","label":"Carousel"}],"default":"grid"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":60,"step":2,"unit":"px","default":32},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":18,"max":40,"step":2,"unit":"px","default":24},{"type":"range","id":"header_spacing","label":"Header spacing","min":12,"max":48,"step":4,"unit":"px","default":24},{"type":"range","id":"card_gap","label":"Desktop card gap","min":8,"max":40,"step":4,"unit":"px","default":16},{"type":"range","id":"mobile_card_gap","label":"Mobile card gap","min":8,"max":32,"step":4,"unit":"px","default":12},{"type":"range","id":"card_radius","label":"Image corner radius","min":0,"max":24,"step":2,"unit":"px","default":0},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"header","content":"Colors"},{"type":"color","id":"text_color","label":"Text","default":"#171717"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#5f5a55"},{"type":"color","id":"button_background","label":"Button background","default":"#171717"},{"type":"color","id":"button_text","label":"Button text","default":"#ffffff"},{"type":"color","id":"placeholder_background","label":"Placeholder background","default":"#f1eee9"}],"presets":[{"name":"Modern collection list"}],"tag":null,"class":"modern-collection-list"}{% endschema %}