{% doc %}
  @prompt
    Create a "Shop by Collection" section with these exact specs:
    
    LAYOUT & GRID:
    - 5 columns on desktop, 4 columns on tablet (768px–1024px), 2 columns on mobile (below 768px)
    - Customizable left padding (padding-inline-start) and right padding (padding-inline-end), both defaulting to 0px
    - Customizable top and bottom padding settings
    - Optional section heading text
    
    CARDS:
    - Each card is fully clickable and links to the collection page
    - Collection image fills the card completely as background (object-fit: cover)
    - Consistent aspect ratio (e.g., 4:5 portrait)
    - Subtle hover effect: slight image zoom (scale 1.05) with smooth transition
    
    TITLE TREATMENT (critical):
    - Collection title sits inside the image at the bottom-left corner
    - DO NOT apply a full-image overlay or darken the entire image
    - Apply a small, localised black gradient ONLY directly behind the title text — like a soft shadow/gradient patch at the bottom-left, not spanning the full card width
    - Title text: white, bold, elegant, small-to-medium font size
    
    SCHEMA SETTINGS:
    - Section heading (text)
    - Number of collections to display
    - Left padding (range: 0–100px, default 0)
    - Right padding (range: 0–100px, default 0)
    - Top padding (range: 0–80px, default 20)
    - Bottom padding (range: 0–80px, default 20)
    
    Keep code clean, semantic, and production-ready., give some border radius to collection cards, currently black gredient is upto half of the card. reduce it to 30% from bottom. it should adapt based on collection title size or portion . also i should able to selelct collection instead of hardcoding collection option., also add view more button, make shop by collection heading bold and look good
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-collections-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-inline-start: {{ block.settings.padding_left }}px;
    padding-inline-end: {{ block.settings.padding_right }}px;
  }

  .ai-shop-collections__heading-{{ ai_gen_id }} {
    margin: 0 0 40px;
    font-size: 40px;
    font-weight: 700;
    text-align: center;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .ai-shop-collections__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .ai-shop-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
    }

    .ai-shop-collections__heading-{{ ai_gen_id }} {
      font-size: 32px;
      margin-bottom: 32px;
    }
  }

  @media (max-width: 768px) {
    .ai-shop-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .ai-shop-collections__heading-{{ ai_gen_id }} {
      font-size: 28px;
      margin-bottom: 28px;
    }
  }

  .ai-shop-collections__card-{{ ai_gen_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-shop-collections__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-shop-collections__card-{{ ai_gen_id }}:hover .ai-shop-collections__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-shop-collections__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-shop-collections__placeholder-{{ ai_gen_id }} svg {
    width: 40%;
    height: 40%;
    opacity: 0.3;
  }

  .ai-shop-collections__title-wrapper-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 16px;
    z-index: 2;
  }

  .ai-shop-collections__title-gradient-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.4) 40%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
    z-index: 1;
    transition: height 0.3s ease;
  }

  .ai-shop-collections__title-{{ ai_gen_id }} {
    position: relative;
    color: #ffffff;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .ai-shop-collections__button-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  .ai-shop-collections__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 500;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-shop-collections__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .ai-shop-collections__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.85 }}px;
    }

    .ai-shop-collections__title-wrapper-{{ ai_gen_id }} {
      padding: 12px;
    }

    .ai-shop-collections__button-wrapper-{{ ai_gen_id }} {
      margin-top: 24px;
    }
  }
{% endstyle %}

<shop-by-collections-{{ ai_gen_id }}
  class="ai-shop-collections-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-shop-collections__heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  <div class="ai-shop-collections__grid-{{ ai_gen_id }}">
    {% if block.settings.collections != blank %}
      {% for collection in block.settings.collections limit: block.settings.collection_count %}
        <a
          href="{{ collection.url }}"
          class="ai-shop-collections__card-{{ ai_gen_id }}"
          data-card-id="{{ forloop.index }}"
        >
          <div class="ai-shop-collections__title-gradient-{{ ai_gen_id }}" data-gradient="{{ forloop.index }}"></div>

          {% if collection.featured_image %}
            <img
              src="{{ collection.featured_image | image_url: width: 600 }}"
              alt="{{ collection.featured_image.alt | escape }}"
              loading="lazy"
              width="600"
              height="750"
              class="ai-shop-collections__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-shop-collections__placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-shop-collections__title-wrapper-{{ ai_gen_id }}" data-title="{{ forloop.index }}">
            <h3 class="ai-shop-collections__title-{{ ai_gen_id }}">
              {{ collection.title }}
            </h3>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..block.settings.collection_count) %}
        <div class="ai-shop-collections__card-{{ ai_gen_id }}" data-card-id="{{ i }}">
          <div class="ai-shop-collections__title-gradient-{{ ai_gen_id }}" data-gradient="{{ i }}"></div>
          <div class="ai-shop-collections__placeholder-{{ ai_gen_id }}">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
          <div class="ai-shop-collections__title-wrapper-{{ ai_gen_id }}" data-title="{{ i }}">
            <h3 class="ai-shop-collections__title-{{ ai_gen_id }}">
              Collection {{ i }}
            </h3>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  {% if block.settings.show_button %}
    <div class="ai-shop-collections__button-wrapper-{{ ai_gen_id }}">
      <a
        href="{{ block.settings.button_link }}"
        class="ai-shop-collections__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    </div>
  {% endif %}
</shop-by-collections-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopByCollections{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-shop-collections__card-{{ ai_gen_id }}');
        this.adjustGradients();
        
        window.addEventListener('resize', () => this.adjustGradients());
      }

      adjustGradients() {
        this.cards.forEach((card) => {
          const titleWrapper = card.querySelector('.ai-shop-collections__title-wrapper-{{ ai_gen_id }}');
          const gradient = card.querySelector('.ai-shop-collections__title-gradient-{{ ai_gen_id }}');
          
          if (titleWrapper && gradient) {
            const titleHeight = titleWrapper.offsetHeight;
            const cardHeight = card.offsetHeight;
            const minGradientHeight = cardHeight * 0.3;
            const gradientHeight = Math.max(titleHeight + 40, minGradientHeight);
            
            gradient.style.height = gradientHeight + 'px';
          }
        });
      }
    }

    customElements.define('shop-by-collections-{{ ai_gen_id }}', ShopByCollections{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Shop by collection",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by collection"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 10
    },
    {
      "type": "range",
      "id": "collection_count",
      "label": "Number of collections to show",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View all collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#C9922A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#B8821A"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Shop by collection"
    }
  ]
}
{% endschema %}
