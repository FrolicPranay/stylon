{% doc %}
  @prompt
    Create a collection showcase section that displays collections in a responsive grid layout with collection images, titles, and a hover overlay effect. The section should support customizable columns (2-4), image aspect ratio options, optional section heading, and a "View All" button. Style should match a premium luxury fashion brand with clean minimal design.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-showcase-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collection-showcase-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-collection-showcase-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .ai-collection-showcase-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.button_spacing }}px;
  }

  .ai-collection-showcase-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f5f5f5;
  }

  .ai-collection-showcase-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.image_aspect_ratio == 'square' %}
      padding-bottom: 100%;
    {% elsif block.settings.image_aspect_ratio == 'portrait' %}
      padding-bottom: 133%;
    {% elsif block.settings.image_aspect_ratio == 'landscape' %}
      padding-bottom: 66%;
    {% elsif block.settings.image_aspect_ratio == 'wide' %}
      padding-bottom: 56%;
    {% endif %}
  }

  .ai-collection-showcase-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-collection-showcase-item-{{ ai_gen_id }}:hover .ai-collection-showcase-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-showcase-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-showcase-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-showcase-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .ai-collection-showcase-item-{{ ai_gen_id }}:hover .ai-collection-showcase-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_hover_opacity }};
  }

  .ai-collection-showcase-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    z-index: 2;
    transform: translateY(0);
    transition: transform 0.3s ease;
  }

  .ai-collection-showcase-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: {{ block.settings.title_transform }};
  }

  .ai-collection-showcase-link-{{ ai_gen_id }} {
    text-decoration: none;
    display: block;
  }

  .ai-collection-showcase-button-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.button_alignment }};
  }

  .ai-collection-showcase-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 40px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: {{ block.settings.button_text_transform }};
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-collection-showcase-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-collection-showcase-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-size: 14px;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-collection-showcase-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-collection-showcase-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
    }

    .ai-collection-showcase-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-collection-showcase-{{ ai_gen_id }} {
      padding: calc({{ block.settings.section_padding }}px * 0.6) 0;
    }
  }
{% endstyle %}

<collection-showcase-{{ ai_gen_id }} class="ai-collection-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-showcase-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-collection-showcase-header-{{ ai_gen_id }}">
        <h2 class="ai-collection-showcase-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if block.settings.collections != blank %}
      <div class="ai-collection-showcase-grid-{{ ai_gen_id }}">
        {% for collection in block.settings.collections %}
          <div class="ai-collection-showcase-item-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-collection-showcase-link-{{ ai_gen_id }}">
              <div class="ai-collection-showcase-image-wrapper-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    srcset="{{ collection.featured_image | image_url: width: 400 }} 400w,
                            {{ collection.featured_image | image_url: width: 600 }} 600w,
                            {{ collection.featured_image | image_url: width: 800 }} 800w"
                    sizes="(max-width: 749px) 100vw, (max-width: 989px) 50vw, 33vw"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-collection-showcase-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ collection.featured_image.width }}"
                    height="{{ collection.featured_image.height }}"
                  >
                {% else %}
                  <div class="ai-collection-showcase-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-collection-showcase-overlay-{{ ai_gen_id }}"></div>
                <div class="ai-collection-showcase-content-{{ ai_gen_id }}">
                  <h3 class="ai-collection-showcase-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>

      {% if block.settings.show_view_all_button and block.settings.view_all_link != blank %}
        <div class="ai-collection-showcase-button-wrapper-{{ ai_gen_id }}">
          <a href="{{ block.settings.view_all_link }}" class="ai-collection-showcase-button-{{ ai_gen_id }}">
            {{ block.settings.view_all_text }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-collection-showcase-empty-{{ ai_gen_id }}">
        Next, add collections to showcase
      </div>
    {% endif %}
  </div>
</collection-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initLazyLoad();
      }

      initLazyLoad() {
        const images = this.querySelectorAll('.ai-collection-showcase-image-{{ ai_gen_id }}');
        if ('IntersectionObserver' in window) {
          const imageObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const img = entry.target;
                img.src = img.dataset.src || img.src;
                observer.unobserve(img);
              }
            });
          });

          images.forEach(img => imageObserver.observe(img));
        }
      }
    }

    customElements.define('collection-showcase-{{ ai_gen_id }}', CollectionShowcase{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection showcase",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collections"
