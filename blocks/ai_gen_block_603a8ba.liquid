{% doc %}
  @prompt
    Create a Luxury Trust Reassurance block for a premium Indian ethnic fashion brand called Stylon. Requirements: 3 trust points — Customer Support (chat SVG icon), Handcrafted Quality (craft/needle SVG icon), Secure Checkout (lock SVG icon). Desktop: horizontal 3-column grid with thin vertical dividers. Mobile: single column with each item as a horizontal row (icon left, text right), horizontal rule dividers between items, very compact. Compact padding on both desktop (28px) and mobile (20px). SVG icons stroke-based, 36px desktop. Gold icons #c9922a, dark titles #1f2937, muted text #6b7280, off-white background #fafafa. Uppercase letter-spaced titles. Subtle fade-in scroll animation. All colors, sizes, padding, and item text customizable via block schema settings., keep it center on mobile, keep mobile icons also center
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-reassurance-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.desktop_padding }}px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .ai-trust-reassurance-{{ ai_gen_id }}.ai-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-trust-reassurance-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .ai-trust-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 {{ block.settings.item_horizontal_padding }}px;
    position: relative;
  }

  .ai-trust-item-{{ ai_gen_id }}:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: {{ block.settings.divider_height }}%;
    background-color: {{ block.settings.divider_color }};
  }

  .ai-trust-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    flex-shrink: 0;
  }

  .ai-trust-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 1.5;
  }

  .ai-trust-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-trust-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-reassurance-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-trust-reassurance-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .ai-trust-item-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: {{ block.settings.mobile_item_padding }}px 0;
    }

    .ai-trust-item-{{ ai_gen_id }}:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      transform: none;
      width: 100%;
      height: 1px;
      background-color: {{ block.settings.divider_color }};
    }

    .ai-trust-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
      margin-bottom: {{ block.settings.mobile_icon_spacing }}px;
      margin-right: 0;
    }

    .ai-trust-content-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-trust-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
      margin-bottom: {{ block.settings.mobile_title_spacing }}px;
    }

    .ai-trust-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<luxury-trust-reassurance-{{ ai_gen_id }} class="ai-trust-reassurance-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-reassurance-grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign enabled_key = 'item_' | append: i | append: '_enabled'
        assign title_key = 'item_' | append: i | append: '_title'
        assign text_key = 'item_' | append: i | append: '_text'
        assign icon_key = 'item_' | append: i | append: '_icon'

        assign enabled = block.settings[enabled_key]
        assign title = block.settings[title_key]
        assign text = block.settings[text_key]
        assign icon = block.settings[icon_key]
      %}

      {% if enabled %}
        <div class="ai-trust-item-{{ ai_gen_id }}">
          <div class="ai-trust-icon-{{ ai_gen_id }}">
            {% case icon %}
              {% when 'chat' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              {% when 'craft' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M12 2v20M17 7h-5M5 7l1.8 9h10.4l1.8-9H5zM8 16v5M16 16v5"></path>
                </svg>
              {% when 'lock' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              {% when 'shipping' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M16 3h5v13h-5M1 8h15v8H1zM1 16l3 3M16 16l3 3"></path>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              {% when 'heart' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              {% when 'star' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            {% endcase %}
          </div>
          <div class="ai-trust-content-{{ ai_gen_id }}">
            <h3 class="ai-trust-title-{{ ai_gen_id }}">{{ title }}</h3>
            <p class="ai-trust-text-{{ ai_gen_id }}">{{ text }}</p>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</luxury-trust-reassurance-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryTrustReassurance{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupScrollAnimation();
      }

      setupScrollAnimation() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('ai-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
          }
        );

        observer.observe(this);
      }
    }

    customElements.define('luxury-trust-reassurance-{{ ai_gen_id }}', LuxuryTrustReassurance{{ ai_gen_id }});
  })();
</script>

