{% doc %}
  @prompt
    Create a new reusable Shopify theme section for the STYLON store called “Discount Collections” or “Shop by Discount”. Use the attached image as the visual style reference: https://sidekick.shopify.ai/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6Mzc5MTIwNzIzMCwicHVyIjoiYmxvYl9pZCJ9fQ==--5f840922b07cc14843233f2226e61665d921462a/WhatsApp_Image_2026-09-17_at_13.33.56.jpeg. Build a premium, modern, fashion-focused responsive section with discount promotion cards such as “Up to 20% Off”, “Up to 40% Off”, and similar offers. Each card must be an editable repeatable block in the Shopify Theme Editor with settings for card image, main discount label, optional supporting text, and a collection picker. Clicking anywhere on a card must link to the selected collection page, where the products in that discount category are displayed. Do not hard-code collection names, handles, product names, prices, or images. Use Shopify's native collection picker and dynamic collection URLs. Make the cards visually similar to the reference with large rounded images, readable text overlay near the bottom, a subtle dark gradient behind the text, and a clean premium presentation matching STYLON. Use the brand accent #FF5A1F tastefully. On desktop, use a balanced multi-card layout with equal card heights and spacing. On mobile, make the cards responsive and touch-friendly, with a clean stacked or horizontally scrollable layout that does not create page-level horizontal overflow. Include sensible Theme Editor settings for section heading, card height, corner radius, text alignment, overlay strength, spacing, and number of columns. Preserve accessibility with meaningful image alt text, keyboard-accessible links, and readable contrast. Use Shopify Liquid, HTML, CSS, and JavaScript only where appropriate, and ensure the section is compatible with the Shopify Theme Editor., i want to show total 5 cards
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-discount-collections-{{ ai_gen_id }}{display:block;width:100%;padding:{{ block.settings.section_spacing }}px 0;background:{{ block.settings.background_color }}}
.ai-discount-collections-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:1440px;margin:0 auto;padding:0 24px}
.ai-discount-collections-{{ ai_gen_id }}__heading{margin:0 0 28px;color:{{ block.settings.heading_color }};font-family:{{ settings.type_heading_font.family }},sans-serif;font-size:clamp(28px,4vw,48px);line-height:1.05;text-align:{{ block.settings.heading_alignment }}}
.ai-discount-collections-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr));gap:{{ block.settings.card_gap }}px}
.ai-discount-collections-{{ ai_gen_id }}__card{position:relative;display:block;height:{{ block.settings.card_height }}px;overflow:hidden;border-radius:{{ block.settings.corner_radius }}px;color:#fff;text-decoration:none;background:#333}
.ai-discount-collections-{{ ai_gen_id }}__media,.ai-discount-collections-{{ ai_gen_id }}__media img,.ai-discount-collections-{{ ai_gen_id }}__placeholder{width:100%;height:100%}.ai-discount-collections-{{ ai_gen_id }}__media img{display:block;object-fit:cover;transition:transform .35s ease}.ai-discount-collections-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;background:#555}.ai-discount-collections-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;opacity:.35}.ai-discount-collections-{{ ai_gen_id }}__shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,{{ block.settings.overlay_strength | divided_by: 100.0 }}),rgba(0,0,0,.02) 70%)}.ai-discount-collections-{{ ai_gen_id }}__content{position:absolute;right:24px;bottom:22px;left:24px;text-align:{{ block.settings.card_text_alignment }}}.ai-discount-collections-{{ ai_gen_id }}__label{margin:0;color:#fff;font-family:{{ settings.type_heading_font.family }},sans-serif;font-size:clamp(24px,3vw,40px);line-height:1}.ai-discount-collections-{{ ai_gen_id }}__supporting{margin:9px 0 0;color:#fff;font-size:14px}.ai-discount-collections-{{ ai_gen_id }}__accent{display:inline-block;width:34px;height:3px;margin-top:14px;background:#FF5A1F;border-radius:3px}.ai-discount-collections-{{ ai_gen_id }}__card:hover img,.ai-discount-collections-{{ ai_gen_id }}__card:focus-visible img{transform:scale(1.04)}.ai-discount-collections-{{ ai_gen_id }}__card:focus-visible{outline:3px solid #FF5A1F;outline-offset:4px}
@media(max-width:749px){.ai-discount-collections-{{ ai_gen_id }}__inner{width:100%;padding:0 16px}.ai-discount-collections-{{ ai_gen_id }}__grid{display:flex;gap:{{ block.settings.card_gap }}px;overflow-x:auto;padding-bottom:8px;scroll-snap-type:x proximity}.ai-discount-collections-{{ ai_gen_id }}__card{flex:0 0 min(82vw,360px);height:{{ block.settings.card_height_mobile }}px;scroll-snap-align:start}}
{% endstyle %}
<div class="ai-discount-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-discount-collections-{{ ai_gen_id }}__inner">{% if block.settings.heading != blank %}<h2 class="ai-discount-collections-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-discount-collections-{{ ai_gen_id }}__grid">{% for i in (1..5) %}{% assign image_key = 'card_' | append: i | append: '_image' %}{% assign label_key = 'card_' | append: i | append: '_label' %}{% assign supporting_key = 'card_' | append: i | append: '_supporting' %}{% assign collection_key = 'card_' | append: i | append: '_collection' %}{% assign image = block.settings[image_key] %}{% assign label = block.settings[label_key] %}{% assign supporting = block.settings[supporting_key] %}{% assign collection = block.settings[collection_key] %}{% if collection != blank %}<a class="ai-discount-collections-{{ ai_gen_id }}__card" href="{{ collection.url }}"><div class="ai-discount-collections-{{ ai_gen_id }}__media">{% if image != blank %}<img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: label | escape }}" loading="lazy">{% else %}<div class="ai-discount-collections-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-discount-collections-{{ ai_gen_id }}__shade"></div><div class="ai-discount-collections-{{ ai_gen_id }}__content"><h3 class="ai-discount-collections-{{ ai_gen_id }}__label">{{ label | escape }}</h3>{% if supporting != blank %}<p class="ai-discount-collections-{{ ai_gen_id }}__supporting">{{ supporting | escape }}</p>{% endif %}<span class="ai-discount-collections-{{ ai_gen_id }}__accent" aria-hidden="true"></span></div></a>{% endif %}{% endfor %}</div></div></div>
{% schema %}{"name":"Discount collections","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by discount"},{"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},{"type":"select","id":"columns_desktop","label":"Columns on desktop","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}],"default":"3"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"card_height","label":"Card height","min":280,"max":620,"step":20,"unit":"px","default":440},{"type":"range","id":"card_height_mobile","label":"Mobile card height","min":240,"max":520,"step":20,"unit":"px","default":360},{"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":18},{"type":"range","id":"card_gap","label":"Card spacing","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"section_spacing","label":"Section spacing","min":20,"max":100,"step":10,"unit":"px","default":60},{"type":"range","id":"overlay_strength","label":"Overlay strength","min":40,"max":90,"step":5,"unit":"%","default":70},{"type":"select","id":"card_text_alignment","label":"Card text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Heading","default":"#000000"},{"type":"header","content":"Card 1"},{"type":"image_picker","id":"card_1_image","label":"Image"},{"type":"text","id":"card_1_label","label":"Discount label","default":"Up to 20% off"},{"type":"text","id":"card_1_supporting","label":"Supporting text","default":"Explore the edit"},{"type":"collection","id":"card_1_collection","label":"Collection"},{"type":"header","content":"Card 2"},{"type":"image_picker","id":"card_2_image","label":"Image"},{"type":"text","id":"card_2_label","label":"Discount label","default":"Up to 40% off"},{"type":"text","id":"card_2_supporting","label":"Supporting text","default":"Explore the edit"},{"type":"collection","id":"card_2_collection","label":"Collection"},{"type":"header","content":"Card 3"},{"type":"image_picker","id":"card_3_image","label":"Image"},{"type":"text","id":"card_3_label","label":"Discount label","default":"Up to 60% off"},{"type":"text","id":"card_3_supporting","label":"Supporting text","default":"Explore the edit"},{"type":"collection","id":"card_3_collection","label":"Collection"},{"type":"header","content":"Card 4"},{"type":"image_picker","id":"card_4_image","label":"Image"},{"type":"text","id":"card_4_label","label":"Discount label","default":"Up to 70% off"},{"type":"text","id":"card_4_supporting","label":"Supporting text","default":"Explore the edit"},{"type":"collection","id":"card_4_collection","label":"Collection"},{"type":"header","content":"Card 5"},{"type":"image_picker","id":"card_5_image","label":"Image"},{"type":"text","id":"card_5_label","label":"Discount label","default":"Up to 80% off"},{"type":"text","id":"card_5_supporting","label":"Supporting text","default":"Explore the edit"},{"type":"collection","id":"card_5_collection","label":"Collection"}],"presets":[{"name":"Discount collections"}],"tag":null,"class":"discount-collections-block"}{% endschema %}