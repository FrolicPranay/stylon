    "custom_liquid_3qpwzF": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<!DOCTYPE html><!DOCTYPE html><!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>STYLON First Order Banner - Big Model</title>\n<style>\n  /* =========================================================\n     STYLON — FIRST ORDER FASHION BANNER\n     Premium Editorial • Orange Abstract • Responsive Landscape\n     ========================================================= */\n\n  :root {\n    --stylon-orange: #FF5A1F;\n    --stylon-orange-glow: rgba(255, 90, 31, 0.4);\n    --stylon-black: #0B0B0B;\n    --stylon-white: #FFFFFF;\n  }\n\n  .stylon-first-order {\n    position: relative;\n    width: 100%;\n    min-height: 400px;\n    overflow: hidden;\n    background: var(--stylon-black);\n    color: var(--stylon-white);\n    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    border-radius: 16px;\n    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);\n  }\n\n  .stylon-first-order *,\n  .stylon-first-order *::before,\n  .stylon-first-order *::after {\n    box-sizing: border-box;\n  }\n\n  /* =========================================================\n     ABSTRACT ORANGE BACKGROUND SHAPES\n     ========================================================= */\n\n  .stylon-first-order::before {\n    content: \"\";\n    position: absolute;\n    width: 600px;\n    height: 600px;\n    left: 20%;\n    top: -250px;\n    border-radius: 50%;\n    background: radial-gradient(circle, var(--stylon-orange-glow) 0%, rgba(255,90,31,0.05) 50%, transparent 70%);\n    filter: blur(24px);\n    z-index: 1;\n    pointer-events: none;\n  }\n\n  .stylon-first-order::after {\n    content: \"\";\n    position: absolute;\n    width: 500px;\n    height: 600px;\n    right: -10%;\n    bottom: -300px;\n    border-radius: 46% 54% 62% 38% / 48% 40% 60% 52%;\n    background: linear-gradient(145deg, #FF6A35 0%, #FF5A1F 48%, #E9440C 100%);\n    transform: rotate(-15deg);\n    box-shadow: -20px -10px 60px rgba(255, 90, 31, 0.2);\n    z-index: 1;\n    pointer-events: none;\n  }\n\n  .stylon-first-order__abstract {\n    position: absolute;\n    width: 200px;\n    height: 350px;\n    right: 35%;\n    top: -10%;\n    border-radius: 58% 42% 65% 35% / 42% 52% 48% 58%;\n    background: linear-gradient(180deg, rgba(255, 90, 31, 0.6), rgba(255, 90, 31, 0.1));\n    transform: rotate(21deg);\n    opacity: 0.4;\n    filter: blur(8px);\n    z-index: 1;\n    pointer-events: none;\n  }\n\n  /* =========================================================\n     LAYOUT \n     ========================================================= */\n\n  .stylon-first-order__inner {\n    position: relative;\n    display: flex;\n    flex-direction: row;\n    width: 100%;\n    height: 100%;\n    min-height: 400px;\n    z-index: 5;\n  }\n\n  /* =========================================================\n     CONTENT AREA\n     ========================================================= */\n\n  .stylon-first-order__content {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    flex: 1.2; \n    padding: 48px 40px 48px clamp(32px, 6vw, 80px);\n    z-index: 10;\n  }\n\n  .stylon-first-order__eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-bottom: 20px;\n    color: rgba(255, 255, 255, 0.8);\n    font-size: clamp(10px, 1.2vw, 12px);\n    font-weight: 800;\n    letter-spacing: 0.25em;\n    text-transform: uppercase;\n  }\n\n  .stylon-first-order__eyebrow::before {\n    content: \"\";\n    width: 32px;\n    height: 2px;\n    background: var(--stylon-orange);\n  }\n\n  .stylon-first-order__heading {\n    margin: 0;\n    color: var(--stylon-white);\n    font-size: clamp(40px, 5.5vw, 84px);\n    line-height: 0.9;\n    letter-spacing: -0.02em;\n    font-weight: 900;\n    text-transform: uppercase;\n  }\n\n  .stylon-first-order__heading .orange {\n    color: var(--stylon-orange);\n  }\n\n  .stylon-first-order__heading .sub {\n    display: block;\n    margin-top: 12px;\n    font-size: clamp(14px, 1.8vw, 22px);\n    line-height: 1.2;\n    letter-spacing: 0.15em;\n  }\n\n  .stylon-first-order__description {\n    max-width: 420px;\n    margin: 20px 0 0;\n    color: rgba(255, 255, 255, 0.75);\n    font-size: clamp(13px, 1.5vw, 16px);\n    line-height: 1.6;\n    font-weight: 400;\n  }\n\n  /* =========================================================\n     COPY CODE BUTTON\n     ========================================================= */\n\n  .stylon-first-order__code {\n    display: inline-flex;\n    align-items: center;\n    width: max-content;\n    margin-top: 32px;\n    padding: 14px 24px;\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    border-radius: 8px;\n    background: rgba(255, 255, 255, 0.08);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    cursor: pointer;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    font: inherit;\n    appearance: none;\n    -webkit-appearance: none;\n  }\n\n  .stylon-first-order__code:hover {\n    background: rgba(255, 255, 255, 0.15);\n    border-color: rgba(255, 255, 255, 0.4);\n    transform: translateY(-2px);\n    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);\n  }\n\n  .stylon-first-order__code:active {\n    transform: translateY(0);\n  }\n\n  .stylon-first-order__code-label {\n    margin-right: 12px;\n    color: rgba(255, 255, 255, 0.6);\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n\n  .stylon-first-order__code-value {\n    padding-left: 12px;\n    border-left: 1px solid rgba(255, 255, 255, 0.2);\n    color: var(--stylon-white);\n    font-size: 16px;\n    font-weight: 900;\n    letter-spacing: 0.1em;\n    transition: color 0.3s ease;\n  }\n\n  /* =========================================================\n     MODEL VISUAL AREA\n     ========================================================= */\n\n  .stylon-first-order__visual {\n    position: relative;\n    flex: 1; \n    display: flex;\n    align-items: flex-end;\n    justify-content: flex-end;\n    padding-right: 4%;\n    z-index: 5;\n  }\n\n  .stylon-first-order__model {\n    position: relative;\n    z-index: 4;\n    width: auto;\n    height: 100%;\n    max-height: 480px;\n    object-fit: contain;\n    object-position: bottom right;\n    filter: drop-shadow(-15px 20px 30px rgba(0, 0, 0, 0.5));\n  }\n\n  .stylon-first-order__vertical {\n    position: absolute;\n    right: 24px;\n    top: 50%;\n    transform: translateY(-50%) rotate(90deg);\n    color: rgba(255, 255, 255, 0.15);\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.5em;\n    white-space: nowrap;\n    z-index: 7;\n  }\n\n  .stylon-first-order__corner {\n    position: absolute;\n    right: 0;\n    bottom: 0;\n    width: 80px;\n    height: 80px;\n    border-top-left-radius: 100%;\n    background: var(--stylon-orange);\n    z-index: 6;\n  }\n\n  /* =========================================================\n     TABLET RESPONSIVENESS\n     ========================================================= */\n\n  @media screen and (max-width: 900px) {\n    .stylon-first-order,\n    .stylon-first-order__inner { min-height: 340px; }\n    .stylon-first-order__content { padding: 32px 24px 32px 40px; }\n    .stylon-first-order__model { max-height: 360px; }\n    .stylon-first-order__vertical { display: none; }\n  }\n\n  /* =========================================================\n     MOBILE (BIG MODEL OVERLAP)\n     ========================================================= */\n\n  @media screen and (max-width: 749px) {\n    .stylon-first-order,\n    .stylon-first-order__inner {\n      min-height: 260px;\n      height: 260px;\n    }\n\n    .stylon-first-order__content {\n      position: relative;\n      width: 65%; /* Allows text space but lets image take over */\n      padding: 24px 16px 24px 24px;\n      z-index: 10;\n      /* Text shadow added to ensure readability if model overlaps */\n      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);\n    }\n\n    .stylon-first-order__eyebrow {\n      font-size: 8px;\n      margin-bottom: 12px;\n    }\n\n    .stylon-first-order__eyebrow::before {\n      width: 20px;\n    }\n\n    .stylon-first-order__heading {\n      font-size: clamp(28px, 7vw, 36px);\n    }\n\n    .stylon-first-order__heading .sub {\n      font-size: clamp(10px, 3vw, 12px);\n      margin-top: 8px;\n    }\n\n    .stylon-first-order__description {\n      font-size: 11px;\n      margin-top: 12px;\n      line-height: 1.4;\n      max-width: 200px;\n      display: -webkit-box;\n      -webkit-line-clamp: 3;\n      -webkit-box-orient: vertical;\n      overflow: hidden;\n    }\n\n    .stylon-first-order__code {\n      margin-top: 16px;\n      padding: 8px 14px;\n      /* Darken button background slightly on mobile for contrast against image */\n      background: rgba(0, 0, 0, 0.3); \n    }\n\n    .stylon-first-order__code-label {\n      font-size: 8px;\n      margin-right: 8px;\n    }\n\n    .stylon-first-order__code-value {\n      font-size: 12px;\n      padding-left: 8px;\n    }\n\n    /* Absolute positioning to let the model take up massive space */\n    .stylon-first-order__visual {\n      position: absolute;\n      right: -5%; /* Push it slightly off screen for dramatic effect */\n      bottom: 0;\n      width: 55%; \n      height: 100%;\n      padding-right: 0;\n      z-index: 2;\n    }\n\n    .stylon-first-order__model {\n      height: 100%;\n      width: 100%;\n      object-fit: contain;\n      object-position: bottom right;\n      /* Scale the model up drastically */\n      transform: scale(1.3);\n      transform-origin: bottom right; \n      filter: drop-shadow(-10px 10px 20px rgba(0, 0, 0, 0.6));\n    }\n\n    .stylon-first-order__corner {\n      width: 48px;\n      height: 48px;\n    }\n\n    .stylon-first-order::after {\n      width: 250px;\n      height: 250px;\n      right: -20%;\n      bottom: -100px;\n    }\n  }\n\n  /* =========================================================\n     SMALL MOBILE REFINEMENT\n     ========================================================= */\n\n  @media screen and (max-width: 400px) {\n    .stylon-first-order,\n    .stylon-first-order__inner {\n      height: 240px;\n      min-height: 240px;\n    }\n    \n    .stylon-first-order__content {\n      padding: 20px 12px 20px 16px;\n      width: 70%;\n    }\n\n    .stylon-first-order__heading {\n      font-size: 26px;\n    }\n    \n    .stylon-first-order__description {\n      font-size: 10px;\n    }\n    \n    .stylon-first-order__visual {\n      width: 60%; \n    }\n  }\n</style>\n</head>\n<body>\n\n<section class=\"stylon-first-order\" aria-label=\"STYLON First Order Offer\">\n\n  <!-- BACKGROUND SHAPES -->\n  <div class=\"stylon-first-order__abstract\"></div>\n\n  <div class=\"stylon-first-order__inner\">\n\n    <!-- =====================================================\n         OFFER CONTENT\n         ===================================================== -->\n    <div class=\"stylon-first-order__content\">\n      <div class=\"stylon-first-order__eyebrow\">\n        First Order Exclusive\n      </div>\n\n      <h2 class=\"stylon-first-order__heading\">\n        20% <span class=\"orange\">OFF</span>\n        <span class=\"sub\">YOUR FIRST ORDER</span>\n      </h2>\n\n      <p class=\"stylon-first-order__description\">\n        Discover STYLON and enjoy an exclusive welcome offer on your first purchase.\n      </p>\n\n      <!-- Glassmorphism Copy Button -->\n      <button type=\"button\" class=\"stylon-first-order__code\" onclick=\"stylonCopyCode(this)\">\n        <span class=\"stylon-first-order__code-label\">Use Code</span>\n        <span class=\"stylon-first-order__code-value\">FIRST20</span>\n      </button>\n    </div>\n\n    <!-- =====================================================\n         MODEL\n         ===================================================== -->\n    <div class=\"stylon-first-order__visual\">\n      <img\n        class=\"stylon-first-order__model\"\n        src=\"https://cdn.shopify.com/s/files/1/0900/4793/8594/files/model.png?v=1789596721\"\n        alt=\"STYLON Fashion Model\"\n        loading=\"lazy\"\n      >\n      <!-- Vertical text for desktop -->\n      <div class=\"stylon-first-order__vertical\">STYLON</div>\n    </div>\n\n    <!-- Small Orange Corner Details -->\n    <div class=\"stylon-first-order__corner\"></div>\n\n  </div>\n</section>\n\n<!-- Functional script for the copy code button -->\n<script>\n  function stylonCopyCode(button) {\n    var codeValueElement = button.querySelector('.stylon-first-order__code-value');\n    var originalText = codeValueElement.textContent;\n    var codeToCopy = \"FIRST20\";\n\n    function copied() {\n      codeValueElement.textContent = \"COPIED ✓\";\n      button.style.backgroundColor = \"rgba(255, 90, 31, 0.4)\";\n      button.style.borderColor = \"#FF5A1F\";\n\n      setTimeout(function () {\n        codeValueElement.textContent = originalText;\n        button.style.backgroundColor = \"\";\n        button.style.borderColor = \"\";\n      }, 1800);\n    }\n\n    if (navigator.clipboard && window.isSecureContext) {\n      navigator.clipboard.writeText(codeToCopy).then(copied).catch(function () {});\n    } else {\n      var input = document.createElement(\"textarea\");\n      input.value = codeToCopy;\n      input.style.position = \"fixed\";\n      input.style.left = \"-9999px\";\n\n      document.body.appendChild(input);\n      input.focus();\n      input.select();\n\n      try {\n        document.execCommand(\"copy\");\n        copied();\n      } catch (e) {}\n\n      document.body.removeChild(input);\n    }\n  }\n</script>\n\n</body>\n</html>",
