    "custom_liquid_QUQX8z": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* =========================================================\n     STYLON — MINIMAL PREMIUM TIERED OFFER RIBBON\n     ========================================================= */\n\n  .stylon-tier-ribbon {\n    --black: #111111;\n    --white: #ffffff;\n    --orange: #FF5A1F;\n    --border: #E4E4E4;\n    --soft: #F7F7F7;\n    --muted: #666666;\n\n    width: 100%;\n    background: var(--white);\n    \n    /* Top and bottom borders removed here */\n\n    color: var(--black);\n    font-family: Arial, Helvetica, sans-serif;\n\n    -webkit-font-smoothing: antialiased;\n    overflow: hidden;\n  }\n\n  .stylon-tier-ribbon *,\n  .stylon-tier-ribbon *::before,\n  .stylon-tier-ribbon *::after {\n    box-sizing: border-box;\n  }\n\n  /* =========================================================\n     MAIN\n     ========================================================= */\n\n  .stylon-tier-ribbon__inner {\n    width: min(1480px, calc(100% - 48px));\n    margin: 0 auto;\n\n    display: flex;\n    align-items: center;\n\n    gap: 34px;\n    padding: 15px 0;\n  }\n\n  /* =========================================================\n     HEADER\n     ========================================================= */\n\n  .stylon-tier-ribbon__header {\n    flex: 0 0 auto;\n    min-width: 195px;\n  }\n\n  .stylon-tier-ribbon__title {\n    display: flex;\n    align-items: center;\n\n    gap: 9px;\n    margin: 0;\n    padding: 0;\n\n    color: var(--black);\n\n    font-size: 13px;\n    line-height: 1;\n\n    font-weight: 900;\n    letter-spacing: 0.12em;\n\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .stylon-tier-ribbon__title::before {\n    content: \"\";\n\n    width: 7px;\n    height: 7px;\n    flex: 0 0 7px;\n\n    border-radius: 50%;\n\n    background: var(--orange);\n\n    box-shadow:\n      0 0 0 4px rgba(255, 90, 31, 0.10);\n  }\n\n  .stylon-tier-ribbon__subtitle {\n    display: none;\n  }\n\n  /* =========================================================\n     OFFER LIST\n     ========================================================= */\n\n  .stylon-tier-list {\n    flex: 1 1 auto;\n    min-width: 0;\n\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n\n    gap: 8px;\n  }\n\n  /* =========================================================\n     OFFER CARD\n     ========================================================= */\n\n  .stylon-tier {\n    position: relative;\n\n    min-width: 0;\n    min-height: 64px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    gap: 12px;\n\n    padding: 11px 15px;\n\n    border: 1px solid var(--border);\n    border-radius: 8px;\n\n    background: var(--white);\n    color: var(--black);\n\n    transition:\n      background-color 0.2s ease,\n      border-color 0.2s ease,\n      transform 0.2s ease,\n      box-shadow 0.2s ease;\n  }\n\n  .stylon-tier:hover {\n    background: var(--soft);\n    border-color: #D8D8D8;\n\n    transform: translateY(-1px);\n\n    box-shadow:\n      0 5px 16px rgba(0, 0, 0, 0.045);\n  }\n\n  /* =========================================================\n     TEXT\n     ========================================================= */\n\n  .stylon-tier__info {\n    min-width: 0;\n\n    display: flex;\n    flex-direction: column;\n\n    gap: 5px;\n  }\n\n  .stylon-tier__qty {\n    display: block;\n\n    color: var(--muted);\n\n    font-size: 11px;\n    line-height: 1;\n\n    font-weight: 800;\n    letter-spacing: 0.08em;\n\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .stylon-tier__discount {\n    display: block;\n\n    color: var(--black);\n\n    font-size: 19px;\n    line-height: 1;\n\n    font-weight: 900;\n\n    letter-spacing: -0.025em;\n    white-space: nowrap;\n  }\n\n  /* =========================================================\n     PLUS ICON\n     ========================================================= */\n\n  .stylon-tier__arrow {\n    width: 29px;\n    height: 29px;\n\n    flex: 0 0 29px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 50%;\n\n    background: var(--soft);\n    color: var(--black);\n\n    font-size: 15px;\n    line-height: 1;\n\n    font-weight: 800;\n\n    transition:\n      background-color 0.2s ease,\n      color 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .stylon-tier:hover .stylon-tier__arrow {\n    background: var(--orange);\n    color: var(--white);\n\n    transform: rotate(90deg);\n  }\n\n  /* =========================================================\n     FEATURED\n     ========================================================= */\n\n  .stylon-tier--featured {\n    overflow: hidden;\n\n    background: var(--black);\n    border-color: var(--black);\n\n    color: var(--white);\n  }\n\n  .stylon-tier--featured:hover {\n    background: #191919;\n    border-color: #191919;\n  }\n\n  .stylon-tier--featured::after {\n    content: \"\";\n\n    position: absolute;\n\n    width: 110px;\n    height: 110px;\n\n    right: -48px;\n    bottom: -58px;\n\n    border-radius: 50%;\n\n    background: var(--orange);\n\n    opacity: 0.8;\n\n    pointer-events: none;\n  }\n\n  .stylon-tier--featured .stylon-tier__qty {\n    color: rgba(255, 255, 255, 0.68);\n  }\n\n  .stylon-tier--featured .stylon-tier__discount {\n    color: var(--white);\n  }\n\n  .stylon-tier--featured .stylon-tier__arrow {\n    background: rgba(255, 255, 255, 0.12);\n    color: var(--white);\n  }\n\n  .stylon-tier--featured:hover .stylon-tier__arrow {\n    background: var(--orange);\n  }\n\n  /* =========================================================\n     POPULAR\n     ========================================================= */\n\n  .stylon-tier__tag {\n    position: absolute;\n\n    top: 6px;\n    right: 7px;\n\n    z-index: 3;\n\n    padding: 4px 7px;\n\n    border-radius: 999px;\n\n    background: var(--orange);\n    color: var(--white);\n\n    font-size: 7px;\n    line-height: 1;\n\n    font-weight: 900;\n    letter-spacing: 0.09em;\n\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  /* =========================================================\n     LARGE DESKTOP\n     ========================================================= */\n\n  @media screen and (min-width: 1200px) {\n\n    .stylon-tier-ribbon__inner {\n      gap: 40px;\n      padding: 16px 0;\n    }\n\n    .stylon-tier-ribbon__header {\n      min-width: 210px;\n    }\n\n    .stylon-tier-ribbon__title {\n      font-size: 13px;\n    }\n\n    .stylon-tier {\n      min-height: 68px;\n      padding: 12px 17px;\n    }\n\n    .stylon-tier__qty {\n      font-size: 11px;\n    }\n\n    .stylon-tier__discount {\n      font-size: 20px;\n    }\n\n    .stylon-tier__arrow {\n      width: 30px;\n      height: 30px;\n      flex-basis: 30px;\n    }\n  }\n\n  /* =========================================================\n     TABLET\n     ========================================================= */\n\n  @media screen and (max-width: 1024px) {\n\n    .stylon-tier-ribbon__inner {\n      width: calc(100% - 32px);\n\n      gap: 18px;\n      padding: 13px 0;\n    }\n\n    .stylon-tier-ribbon__header {\n      min-width: 150px;\n    }\n\n    .stylon-tier-ribbon__title {\n      font-size: 11px;\n    }\n\n    .stylon-tier-list {\n      gap: 6px;\n    }\n\n    .stylon-tier {\n      min-height: 59px;\n      padding: 9px 11px;\n\n      border-radius: 7px;\n    }\n\n    .stylon-tier__qty {\n      font-size: 9px;\n    }\n\n    .stylon-tier__discount {\n      font-size: 16px;\n    }\n\n    .stylon-tier__arrow {\n      width: 26px;\n      height: 26px;\n      flex-basis: 26px;\n      font-size: 13px;\n    }\n\n    .stylon-tier__tag {\n      top: 5px;\n      right: 5px;\n      padding: 3px 5px;\n      font-size: 6px;\n    }\n  }\n\n  /* =========================================================\n     MOBILE\n     ========================================================= */\n\n  @media screen and (max-width: 749px) {\n\n    .stylon-tier-ribbon__inner {\n      width: 100%;\n      display: block;\n\n      padding: 12px 0 13px;\n    }\n\n    .stylon-tier-ribbon__header {\n      width: calc(100% - 32px);\n      min-width: 0;\n\n      margin: 0 auto 9px;\n    }\n\n    .stylon-tier-ribbon__title {\n      font-size: 10px;\n      letter-spacing: 0.11em;\n    }\n\n    .stylon-tier-ribbon__title::before {\n      width: 6px;\n      height: 6px;\n      flex-basis: 6px;\n    }\n\n    /* Horizontal mobile row */\n\n    .stylon-tier-list {\n      display: flex;\n      width: 100%;\n\n      overflow-x: auto;\n      overflow-y: hidden;\n\n      gap: 7px;\n\n      padding: 0 16px 3px;\n\n      scroll-snap-type: x proximity;\n      scroll-padding-left: 16px;\n\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n    }\n\n    .stylon-tier-list::-webkit-scrollbar {\n      display: none;\n    }\n\n    .stylon-tier {\n      flex: 0 0 150px;\n      width: 150px;\n\n      min-height: 66px;\n\n      padding: 10px 11px;\n\n      border-radius: 8px;\n\n      scroll-snap-align: start;\n    }\n\n    .stylon-tier__qty {\n      font-size: 9px;\n    }\n\n    .stylon-tier__discount {\n      font-size: 16px;\n    }\n\n    .stylon-tier__arrow {\n      width: 26px;\n      height: 26px;\n      flex-basis: 26px;\n\n      font-size: 13px;\n    }\n\n    .stylon-tier__tag {\n      top: 5px;\n      right: 5px;\n\n      padding: 3px 5px;\n\n      font-size: 5.5px;\n    }\n  }\n\n  /* =========================================================\n     SMALL MOBILE\n     ========================================================= */\n\n  @media screen and (max-width: 400px) {\n\n    .stylon-tier-ribbon__header {\n      width: calc(100% - 24px);\n      margin-bottom: 8px;\n    }\n\n    .stylon-tier-ribbon__title {\n      font-size: 9px;\n    }\n\n    .stylon-tier-list {\n      padding-left: 12px;\n      padding-right: 12px;\n\n      gap: 6px;\n    }\n\n    .stylon-tier {\n      flex-basis: 142px;\n      width: 142px;\n\n      min-height: 63px;\n\n      padding: 9px 10px;\n    }\n\n    .stylon-tier__qty {\n      font-size: 8px;\n    }\n\n    .stylon-tier__discount {\n      font-size: 15px;\n    }\n\n    .stylon-tier__arrow {\n      width: 24px;\n      height: 24px;\n      flex-basis: 24px;\n    }\n  }\n\n  /* =========================================================\n     VERY SMALL DEVICES\n     ========================================================= */\n\n  @media screen and (max-width: 340px) {\n\n    .stylon-tier-ribbon__header {\n      width: calc(100% - 20px);\n    }\n\n    .stylon-tier-list {\n      padding-left: 10px;\n      padding-right: 10px;\n    }\n\n    .stylon-tier {\n      flex-basis: 135px;\n      width: 135px;\n    }\n\n    .stylon-tier__discount {\n      font-size: 14px;\n    }\n  }\n\n  /* =========================================================\n     REDUCED MOTION\n     ========================================================= */\n\n  @media (prefers-reduced-motion: reduce) {\n\n    .stylon-tier,\n    .stylon-tier__arrow {\n      transition: none;\n    }\n  }\n</style>\n\n<aside class=\"stylon-tier-ribbon\" aria-label=\"STYLON Tiered Offers\">\n  <div class=\"stylon-tier-ribbon__inner\">\n\n    <!-- HEADER -->\n    <div class=\"stylon-tier-ribbon__header\">\n      <h3 class=\"stylon-tier-ribbon__title\">\n        Current Offers\n      </h3>\n    </div>\n\n    <!-- OFFERS -->\n    <div class=\"stylon-tier-list\">\n\n      <!-- BUY 2 -->\n      <div class=\"stylon-tier\">\n        <div class=\"stylon-tier__info\">\n          <span class=\"stylon-tier__qty\">\n            Buy 2\n          </span>\n          <span class=\"stylon-tier__discount\">\n            10% OFF\n          </span>\n        </div>\n        <span class=\"stylon-tier__arrow\" aria-hidden=\"true\">\n          +\n        </span>\n      </div>\n\n      <!-- BUY 3 -->\n      <div class=\"stylon-tier\">\n        <div class=\"stylon-tier__info\">\n          <span c