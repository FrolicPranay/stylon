n: 0;\n    color: #666666;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  .stylon-contact__details {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .stylon-contact__item {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n    padding: 22px 0;\n    border-bottom: 1px solid #e9e9e9;\n    text-decoration: none;\n  }\n\n  .stylon-contact__item:first-child {\n    border-top: 1px solid #e9e9e9;\n  }\n\n  .stylon-contact__icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    flex-shrink: 0;\n    border-radius: 50%;\n    background: #FFF1EB;\n    color: #FF5A1F;\n  }\n\n  .stylon-contact__icon svg {\n    width: 19px;\n    height: 19px;\n  }\n\n  .stylon-contact__info {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n\n  .stylon-contact__type {\n    color: #999999;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n\n  .stylon-contact__value {\n    color: #181818;\n    font-size: 16px;\n    font-weight: 500;\n  }\n\n  .stylon-contact__item:hover .stylon-contact__value {\n    color: #FF5A1F;\n  }\n\n  @media screen and (max-width: 749px) {\n    .stylon-contact {\n      padding: 50px 20px;\n    }\n\n    .stylon-contact__grid {\n      grid-template-columns: 1fr;\n      gap: 40px;\n    }\n\n    .stylon-contact__title {\n      font-size: 36px;\n      letter-spacing: -1px;\n    }\n\n    .stylon-contact__text {\n      font-size: 15px;\n    }\n\n    .stylon-contact__item {\n      padding: 18px 0;\n    }\n\n    .stylon-contact__value {\n      font-size: 15px;\n    }\n  }\n<\/style>\n\n<section class=\"stylon-contact\">\n  <div class=\"stylon-contact__inner\">\n\n    <div class=\"stylon-contact__grid\">\n\n      <!-- Heading -->\n      <div>\n        <span class=\"stylon-contact__label\">Contact Us<\/span>\n\n        <h2 class=\"stylon-contact__title\">\n          We’re here to help.\n        <\/h2>\n\n        <p class=\"stylon-contact__text\">\n          Have a question about your order or our products?\n          Get in touch with us and our team will be happy to assist you.\n        <\/p>\n      <\/div>\n\n      <!-- Contact Details -->\n      <div class=\"stylon-contact__details\">\n\n        <!-- Email -->\n        <a\n          href=\"mailto:hello@shopstylon.com\"\n          class=\"stylon-contact__item\"\n        >\n          <span class=\"stylon-contact__icon\">\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            >\n              <rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"><\/rect>\n              <path d=\"M3 7l9 6 9-6\"><\/path>\n            <\/svg>\n          <\/span>\n\n          <span class=\"stylon-contact__info\">\n            <span class=\"stylon-contact__type\">Email<\/span>\n            <span class=\"stylon-contact__value\">\n              hello@shopstylon.com\n            <\/span>\n          <\/span>\n        <\/a>\n\n        <!-- Phone -->\n        <a\n          href=\"tel:+919922440669\"\n          class=\"stylon-contact__item\"\n        >\n          <span class=\"stylon-contact__icon\">\n            <svg\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.8\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            >\n              <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2\n                19.79 19.79 0 0 1-8.63-3.07\n                19.5 19.5 0 0 1-6-6\n                19.79 19.79 0 0 1-3.07-8.67\n                A2 2 0 0 1 4.11 2h3\n                a2 2 0 0 1 2 1.72\n                12.84 12.84 0 0 1 .7 2.81\n                2 2 0 0 1-.45 2.11L8.09 9.91\n                a16 16 0 0 0 6 6l1.27-1.27\n                a